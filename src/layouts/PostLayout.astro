---
import Layout from './Layout.astro';
import SupportBlock from '../components/SupportBlock.astro';
import type { EnrichedPost } from '../utils/posts';

interface Props {
  enrichedPost: EnrichedPost;
  prevPost?: EnrichedPost;
  nextPost?: EnrichedPost;
}

const { enrichedPost, prevPost, nextPost } = Astro.props;
const { post, formattedDate, category, categoryLabel } = enrichedPost;
const author = post.data.author || 'LibreELEC Team';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const homeUrl = base ? `${base}/` : '/';
const newsUrl = `${base}/news/`;
---

<Layout title={`${post.data.title} - LibreELEC`} description={post.data.description || 'LibreELEC announcement and release information.'}>
    <article class="pt-32 pb-24">
        <!-- Hero Header -->
        <header class="bg-gradient-to-b from-slate-100/70 dark:from-slate-900/60 to-transparent border-b border-slate-200/60 dark:border-slate-800 pb-16 pt-8 mb-12">
            <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
                <!-- Breadcrumbs -->
                <nav class="flex items-center gap-2 text-xs font-semibold text-slate-500 dark:text-slate-400 mb-6">
                    <a href={homeUrl} class="hover:text-brand-600 dark:hover:text-brand-400 transition-colors">Home</a>
                    <i class="fa-solid fa-chevron-right text-[10px] text-slate-400 dark:text-slate-600"></i>
                    <a href={newsUrl} class="hover:text-brand-600 dark:hover:text-brand-400 transition-colors">News</a>
                    <i class="fa-solid fa-chevron-right text-[10px] text-slate-400 dark:text-slate-600"></i>
                    <span class="text-slate-800 dark:text-slate-200 line-clamp-1">{post.data.title}</span>
                </nav>

                <!-- Badges & Meta -->
                <div class="flex flex-wrap items-center gap-3 mb-4">
                    {category === 'release' ? (
                        <span class="px-3 py-1 rounded-full text-xs font-bold bg-brand-50 dark:bg-brand-950/60 text-brand-700 dark:text-brand-300 border border-brand-200 dark:border-brand-800">
                            {categoryLabel}
                        </span>
                    ) : (
                        <span class="px-3 py-1 rounded-full text-xs font-bold bg-amber-50 dark:bg-amber-950/60 text-amber-700 dark:text-amber-300 border border-amber-200 dark:border-amber-800">
                            {categoryLabel}
                        </span>
                    )}
                    <span class="text-xs text-slate-500 dark:text-slate-400 font-mono flex items-center gap-1.5">
                        <i class="fa-regular fa-calendar text-slate-400 dark:text-slate-500"></i> {formattedDate}
                    </span>
                    <span class="text-slate-300 dark:text-slate-600">•</span>
                    <span class="text-xs text-slate-500 dark:text-slate-400 flex items-center gap-1.5 font-medium">
                        <i class="fa-solid fa-user text-brand-600 dark:text-brand-400"></i> {author}
                    </span>
                </div>

                <!-- Title -->
                <h1 class="text-3xl sm:text-5xl font-extrabold text-slate-900 dark:text-white tracking-tight leading-tight mb-4">
                    {post.data.title}
                </h1>

                {post.data.description && (
                    <p class="text-lg text-slate-600 dark:text-slate-300 leading-relaxed font-normal">
                        {post.data.description}
                    </p>
                )}
            </div>
        </header>

        <!-- Main Content Area -->
        <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="glass-card rounded-3xl p-6 sm:p-12 border border-slate-200 dark:border-slate-800">
                <div class="prose max-w-none text-slate-700 dark:text-slate-300 text-sm sm:text-base leading-relaxed">
                    <slot />
                </div>

                <script is:inline>
                    (function() {
                        const base = (window.location.pathname.startsWith('/website-new') ? '/website-new' : '');
                        if (base) {
                            document.querySelectorAll('.prose a').forEach(function(link) {
                                const href = link.getAttribute('href');
                                if (!href) return;
                                if (href.startsWith('/downloads')) {
                                    link.setAttribute('href', base + href);
                                } else if (href.startsWith('https://libreelec.tv/downloads')) {
                                    link.setAttribute('href', href.replace('https://libreelec.tv', base));
                                }
                            });
                        }
                    })();
                </script>

                {post.data.support !== false && <SupportBlock />}

                <!-- Post Footer Actions -->
                <div class="mt-12 pt-8 border-t border-slate-200 dark:border-slate-800 flex flex-col sm:flex-row items-center justify-between gap-4">
                    <a
                        href={newsUrl}
                        class="px-5 py-2.5 rounded-xl bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 font-bold text-xs flex items-center gap-2 transition-colors"
                    >
                        <i class="fa-solid fa-arrow-left"></i> All News & Releases
                    </a>
                    <div class="flex items-center gap-3">
                        <a
                            href={`https://x.com/intent/tweet?text=${encodeURIComponent(post.data.title)}&url=${encodeURIComponent(Astro.url.href)}`}
                            target="_blank"
                            rel="noopener"
                            class="px-4 py-2 rounded-xl bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white text-xs font-semibold flex items-center gap-1.5 transition-colors"
                        >
                            <i class="fa-brands fa-x-twitter"></i> Share
                        </a>
                        <a
                            href="https://forum.libreelec.tv"
                            target="_blank"
                            rel="noopener"
                            class="px-4 py-2 rounded-xl bg-brand-50 dark:bg-brand-950/60 hover:bg-brand-100 dark:hover:bg-brand-900/60 text-brand-700 dark:text-brand-300 text-xs font-bold flex items-center gap-1.5 transition-colors border border-brand-200 dark:border-brand-800"
                        >
                            <i class="fa-solid fa-comments"></i> Discuss on Forum
                        </a>
                    </div>
                </div>
            </div>

            <!-- Previous / Next Navigation Cards -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-8">
                {prevPost ? (
                    <a
                        href={prevPost.url}
                        class="glass-card p-5 rounded-2xl border border-slate-200 dark:border-slate-800 hover:border-brand-500 dark:hover:border-brand-400 transition-all flex flex-col justify-between group"
                    >
                        <span class="text-[11px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider mb-1 flex items-center gap-1">
                            <i class="fa-solid fa-arrow-left group-hover:-translate-x-1 transition-transform"></i> Older Release
                        </span>
                        <span class="text-sm font-bold text-slate-900 dark:text-white group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-colors line-clamp-1">
                            {prevPost.post.data.title}
                        </span>
                        <span class="text-[11px] text-slate-400 dark:text-slate-500 font-mono mt-2">{prevPost.formattedDate}</span>
                    </a>
                ) : <div />}

                {nextPost ? (
                    <a
                        href={nextPost.url}
                        class="glass-card p-5 rounded-2xl border border-slate-200 dark:border-slate-800 hover:border-brand-500 dark:hover:border-brand-400 transition-all flex flex-col justify-between group text-right"
                    >
                        <span class="text-[11px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider mb-1 flex items-center justify-end gap-1">
                            Newer Release <i class="fa-solid fa-arrow-right group-hover:translate-x-1 transition-transform"></i>
                        </span>
                        <span class="text-sm font-bold text-slate-900 dark:text-white group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-colors line-clamp-1">
                            {nextPost.post.data.title}
                        </span>
                        <span class="text-[11px] text-slate-400 dark:text-slate-500 font-mono mt-2">{nextPost.formattedDate}</span>
                    </a>
                ) : <div />}
            </div>
        </div>
    </article>
</Layout>
