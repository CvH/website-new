---
import Layout from '../../layouts/Layout.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const homeUrl = base ? `${base}/` : '/';

const openCollectiveDonateUrl = 'https://opencollective.com/libreelec/donate';
const openCollectiveUrl = 'https://opencollective.com/libreelec';
const merchShopUrl = 'https://libreelec.shop';
const forumUrl = 'https://forum.libreelec.tv';
const githubUrl = 'https://github.com/LibreELEC/LibreELEC.tv/';
const wikiUrl = 'https://wiki.libreelec.tv';

const expenses = [
  {
    icon: 'fa-server',
    color: 'text-brand-500 bg-brand-500/10',
    title: 'Download Mirrors & Build Servers',
    desc: 'Hosting global mirror networks that distribute multi-terabyte OS images and running automated build servers.',
  },
  {
    icon: 'fa-microchip',
    color: 'text-emerald-500 bg-emerald-500/10',
    title: 'Hardware Testing',
    desc: 'Purchasing SBC boards (Raspberry Pi, Amlogic, Rockchip, Allwinner), remotes, and tuners when vendors cannot supply samples.',
  },
  {
    icon: 'fa-globe',
    color: 'text-purple-500 bg-purple-500/10',
    title: 'Domain & Core Infrastructure',
    desc: 'Annual domain registrations, DNS routing services, security certificates, and maintenance tooling.',
  },
  {
    icon: 'fa-hands-holding-circle',
    color: 'text-amber-500 bg-amber-500/10',
    title: 'Ecosystem Collaboration',
    desc: 'Supporting downstream and related project contributors whose testing and code improve components we depend upon.',
  },
];

const otherWays = [
  {
    url: githubUrl,
    icon: 'fa-brands fa-github',
    title: 'Code & Packaging',
    desc: 'Submit bug fixes, update packages, or port support for new single-board computers on GitHub.',
  },
  {
    url: forumUrl,
    icon: 'fa-solid fa-comments',
    title: 'Community Forum',
    desc: 'Answer questions and share troubleshooting tips with fellow users on our community forum.',
  },
  {
    url: wikiUrl,
    icon: 'fa-solid fa-book-open',
    title: 'Documentation',
    desc: 'Help write and maintain installation guides, hardware FAQs, and tutorials on the wiki.',
  },
];
---

<Layout
    title="Sponsor & Donate - LibreELEC"
    description="Support LibreELEC development. Learn about our project expenses, transparent donations via OpenCollective, and official merchandise."
>
    <!-- Page Hero Header -->
    <header class="relative pt-28 pb-12 md:pt-32 md:pb-16 overflow-hidden hero-gradient border-b border-slate-200 dark:border-slate-800">
        <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-rose-400/10 dark:bg-rose-500/10 rounded-full blur-[120px] pointer-events-none"></div>
        <div class="absolute top-1/3 right-10 w-[300px] h-[300px] bg-brand-400/10 dark:bg-brand-500/10 rounded-full blur-[100px] pointer-events-none"></div>

        <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center">
            <!-- Breadcrumbs -->
            <nav class="flex items-center justify-center gap-2 text-xs font-semibold text-slate-500 dark:text-slate-400 mb-6">
                <a href={homeUrl} class="hover:text-brand-600 dark:hover:text-brand-400 transition-colors">Home</a>
                <i class="fa-solid fa-chevron-right text-[10px] text-slate-400 dark:text-slate-600"></i>
                <span class="text-slate-800 dark:text-slate-200">Sponsor</span>
            </nav>

            <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-rose-50 dark:bg-rose-950/70 border border-rose-200/80 dark:border-rose-900/60 text-rose-700 dark:text-rose-300 text-xs font-bold uppercase tracking-wider mb-4 shadow-sm">
                <i class="fa-solid fa-heart text-rose-500"></i> Non-Profit & Volunteer-Run
            </span>

            <h1 class="text-4xl sm:text-5xl md:text-6xl font-extrabold text-slate-900 dark:text-white tracking-tight mb-4">
                Sponsor <span class="text-gradient">LibreELEC</span>
            </h1>

            <p class="max-w-2xl mx-auto text-base sm:text-lg text-slate-600 dark:text-slate-300 leading-relaxed mb-8">
                LibreELEC software is free but running the project is not, so we raise funds via public donations and sales of project logo themed merchandise.
            </p>

            <!-- Hero Action Buttons -->
            <div class="flex flex-col sm:flex-row items-center justify-center gap-3.5">
                <a
                    href={openCollectiveDonateUrl}
                    target="_blank"
                    rel="noopener"
                    class="w-full sm:w-auto px-7 py-3.5 rounded-xl bg-rose-600 hover:bg-rose-700 text-white font-bold text-sm shadow-lg shadow-rose-500/25 hover:shadow-rose-500/40 hover:-translate-y-0.5 transition-all duration-200 flex items-center justify-center gap-2"
                >
                    <i class="fa-solid fa-heart"></i>
                    <span>Donate on OpenCollective</span>
                </a>
                <a
                    href={merchShopUrl}
                    target="_blank"
                    rel="noopener"
                    class="w-full sm:w-auto px-6 py-3.5 rounded-xl bg-white dark:bg-slate-800 hover:bg-slate-50 dark:hover:bg-slate-700/80 text-slate-800 dark:text-slate-100 font-semibold text-sm border border-slate-200 dark:border-slate-700 hover:border-brand-400 dark:hover:border-brand-500 shadow-sm transition-all duration-200 flex items-center justify-center gap-2"
                >
                    <i class="fa-solid fa-bag-shopping text-brand-600 dark:text-brand-400"></i>
                    <span>Official Merch Store</span>
                </a>
            </div>
        </div>
    </header>

    <!-- Main Content -->
    <main class="py-12 md:py-16 bg-slate-50/70 dark:bg-[#0b1329] min-h-screen">
        <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
            <article class="glass-card rounded-3xl p-6 sm:p-10 md:p-12 border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 space-y-12">
                
                <!-- Section 1: Expenses -->
                <section id="expenses" class="scroll-mt-28">
                    <div class="flex items-center gap-3 mb-4 pb-3 border-b border-slate-200 dark:border-slate-800">
                        <span class="w-8 h-8 rounded-xl bg-brand-600 text-white flex items-center justify-center font-bold text-xs shrink-0">
                            <i class="fa-solid fa-receipt"></i>
                        </span>
                        <h2 class="text-xl sm:text-2xl font-bold text-slate-900 dark:text-white tracking-tight uppercase">
                            Expenses
                        </h2>
                    </div>

                    <p class="text-slate-600 dark:text-slate-300 text-sm sm:text-base leading-relaxed mb-6">
                        Our recurring expenses are hosting for downloads and build servers, and annual domain fees. We also encourage project staff and some regular contributors to expense test hardware when we can't source it for free. We also extend this support to contributors of several downstream and related projects in our ecosystem who collaborate with us, as their testing and efforts often improve things we depend upon.
                    </p>

                    <!-- Expenses Grid -->
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        {expenses.map((item) => (
                            <div class="p-4 sm:p-5 rounded-2xl bg-slate-50 dark:bg-slate-800/50 border border-slate-200 dark:border-slate-700/70 flex items-start gap-3.5">
                                <div class:list={["w-9 h-9 rounded-xl flex items-center justify-center text-sm shrink-0", item.color]}>
                                    <i class:list={["fa-solid", item.icon]}></i>
                                </div>
                                <div>
                                    <h3 class="text-sm font-bold text-slate-900 dark:text-white mb-1">{item.title}</h3>
                                    <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">{item.desc}</p>
                                </div>
                            </div>
                        ))}
                    </div>
                </section>

                <!-- Section 2: Donations -->
                <section id="donations" class="scroll-mt-28">
                    <div class="flex items-center gap-3 mb-4 pb-3 border-b border-slate-200 dark:border-slate-800">
                        <span class="w-8 h-8 rounded-xl bg-rose-600 text-white flex items-center justify-center font-bold text-xs shrink-0">
                            <i class="fa-solid fa-heart"></i>
                        </span>
                        <h2 class="text-xl sm:text-2xl font-bold text-slate-900 dark:text-white tracking-tight uppercase">
                            Donations
                        </h2>
                    </div>

                    <div class="space-y-4 text-slate-600 dark:text-slate-300 text-sm sm:text-base leading-relaxed mb-6">
                        <p>
                            We accept donations through OpenCollective which helps us to manage funds transparently and provide visible recognition to our personal and corporate supporters. Personal donors can request a tag for their forum account by sending an email to our contact@domain address with the details. If you have a repeating donation to our legacy PayPal account we would love you to switch over to OpenCollective.
                        </p>
                        <p>
                            Please send donations to our <a href={openCollectiveDonateUrl} target="_blank" rel="noopener" class="text-brand-600 dark:text-brand-400 font-semibold underline hover:no-underline">Open Collective</a> account or use the button below.
                        </p>
                    </div>

                    <!-- Direct Donation Action Banner -->
                    <div class="p-6 rounded-2xl bg-gradient-to-r from-rose-50/90 to-amber-50/70 dark:from-rose-950/40 dark:to-slate-800/80 border border-rose-200/80 dark:border-rose-900/60 flex flex-col sm:flex-row items-center justify-between gap-5">
                        <div class="flex items-center gap-4 text-center sm:text-left">
                            <div class="w-12 h-12 rounded-xl bg-rose-500/15 border border-rose-500/30 text-rose-600 dark:text-rose-400 flex items-center justify-center text-xl shrink-0 mx-auto sm:mx-0">
                                <i class="fa-solid fa-hand-holding-heart"></i>
                            </div>
                            <div>
                                <h3 class="text-base font-bold text-slate-900 dark:text-white">Donate via OpenCollective</h3>
                                <p class="text-xs text-slate-600 dark:text-slate-300 mt-0.5">
                                    One-time or monthly contributions with public ledger transparency.
                                </p>
                            </div>
                        </div>
                        <div class="flex flex-col sm:flex-row items-center gap-2.5 w-full sm:w-auto shrink-0">
                            <a
                                href={openCollectiveDonateUrl}
                                target="_blank"
                                rel="noopener"
                                class="w-full sm:w-auto px-6 py-3 rounded-xl bg-rose-600 hover:bg-rose-700 text-white font-bold text-xs shadow-md shadow-rose-500/25 hover:shadow-rose-500/40 transition-all flex items-center justify-center gap-2"
                            >
                                <i class="fa-solid fa-heart"></i> Donate Now
                            </a>
                            <a
                                href={openCollectiveUrl}
                                target="_blank"
                                rel="noopener"
                                class="w-full sm:w-auto px-4 py-3 rounded-xl bg-white dark:bg-slate-800 hover:bg-slate-50 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 border border-slate-200 dark:border-slate-700 font-semibold text-xs transition-all flex items-center justify-center gap-1.5"
                            >
                                <i class="fa-solid fa-arrow-up-right-from-square text-[10px]"></i> View Public Budget
                            </a>
                        </div>
                    </div>

                    <!-- Forum tag & PayPal helper cards -->
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mt-4">
                        <div class="p-4 rounded-xl bg-slate-50 dark:bg-slate-800/50 border border-slate-200 dark:border-slate-700/70">
                            <h4 class="font-bold text-slate-900 dark:text-white text-xs mb-1 flex items-center gap-1.5">
                                <i class="fa-solid fa-certificate text-amber-500"></i> Forum Supporter Tag
                            </h4>
                            <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
                                Donors can request a forum supporter badge by emailing donation details to our team.
                            </p>
                        </div>
                        <div class="p-4 rounded-xl bg-slate-50 dark:bg-slate-800/50 border border-slate-200 dark:border-slate-700/70">
                            <h4 class="font-bold text-slate-900 dark:text-white text-xs mb-1 flex items-center gap-1.5">
                                <i class="fa-brands fa-paypal text-sky-500"></i> Switching from PayPal
                            </h4>
                            <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
                                Have an older repeating PayPal pledge? Switching to OpenCollective offers lower fees and full transparency.
                            </p>
                        </div>
                    </div>
                </section>

                <!-- Section 3: Merchandise -->
                <section id="merchandise" class="scroll-mt-28">
                    <div class="flex items-center gap-3 mb-4 pb-3 border-b border-slate-200 dark:border-slate-800">
                        <span class="w-8 h-8 rounded-xl bg-amber-600 text-white flex items-center justify-center font-bold text-xs shrink-0">
                            <i class="fa-solid fa-shirt"></i>
                        </span>
                        <h2 class="text-xl sm:text-2xl font-bold text-slate-900 dark:text-white tracking-tight uppercase">
                            Merchandise
                        </h2>
                    </div>

                    <div class="p-6 rounded-2xl bg-slate-50 dark:bg-slate-800/50 border border-slate-200 dark:border-slate-700/70 flex flex-col sm:flex-row items-center justify-between gap-6">
                        <div class="space-y-2 text-center sm:text-left">
                            <p class="text-slate-600 dark:text-slate-300 text-sm leading-relaxed">
                                The project sells project logo themed t-shirts, hoodies, mugs, stickers, etc. from our <a href={merchShopUrl} target="_blank" rel="noopener" class="text-brand-600 dark:text-brand-400 font-semibold underline hover:no-underline">TeeSpring Merch</a> store with profits contributing to the project.
                            </p>
                            <p class="text-xs text-slate-500 dark:text-slate-400">
                                Official LibreELEC apparel, mugs, and accessories shipped worldwide.
                            </p>
                        </div>
                        <a
                            href={merchShopUrl}
                            target="_blank"
                            rel="noopener"
                            class="shrink-0 px-6 py-3 rounded-xl bg-brand-600 hover:bg-brand-700 text-white font-bold text-xs shadow-md shadow-brand-500/20 hover:shadow-brand-500/35 hover:-translate-y-0.5 transition-all duration-200 flex items-center gap-2"
                        >
                            <i class="fa-solid fa-bag-shopping"></i>
                            <span>Visit Merch Store</span>
                        </a>
                    </div>
                </section>

                <!-- Section 4: Other Ways to Help -->
                <section class="pt-2">
                    <h3 class="text-base font-bold text-slate-900 dark:text-white mb-2 flex items-center gap-2">
                        <i class="fa-solid fa-handshake-angle text-brand-600 dark:text-brand-400"></i> Other Ways to Help
                    </h3>
                    <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed mb-4">
                        Beyond financial support, contributing your time and expertise is invaluable:
                    </p>

                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3.5">
                        {otherWays.map((item) => (
                            <a
                                href={item.url}
                                target="_blank"
                                rel="noopener"
                                class="p-4 rounded-xl bg-slate-50 dark:bg-slate-800/50 border border-slate-200 dark:border-slate-700/70 hover:border-brand-400 dark:hover:border-brand-500 transition-all group"
                            >
                                <div class="flex items-center gap-2 text-slate-900 dark:text-white font-bold text-xs mb-1 group-hover:text-brand-600 dark:group-hover:text-brand-400">
                                    <i class:list={[item.icon, "text-sm text-slate-500 dark:text-slate-400 group-hover:text-brand-600 dark:group-hover:text-brand-400"]}></i>
                                    <span>{item.title}</span>
                                </div>
                                <p class="text-[11px] text-slate-500 dark:text-slate-400 leading-relaxed m-0">
                                    {item.desc}
                                </p>
                            </a>
                        ))}
                    </div>
                </section>

            </article>
        </div>
    </main>
</Layout>
