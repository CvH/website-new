---
import Layout from '../../layouts/Layout.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const homeUrl = base ? `${base}/` : '/';
const openCollectiveDonateUrl = 'https://opencollective.com/libreelec/donate';
const openCollectiveUrl = 'https://opencollective.com/libreelec';
const merchShopUrl = 'https://libreelec.shop';
const forumUrl = 'https://forum.libreelec.tv';
const githubUrl = 'https://github.com/LibreELEC/LibreELEC.tv/';
const wikiUrl = 'https://wiki.libreelec.tv';
---

<Layout
    title="Sponsor & Donate - LibreELEC"
    description="Support LibreELEC development. Learn about our project expenses, transparent donations via OpenCollective, and official merchandise."
>
    <!-- Page Hero Header -->
    <header class="relative pt-28 pb-12 md:pt-32 md:pb-16 overflow-hidden hero-gradient border-b border-slate-200 dark:border-slate-800">
        <!-- Ambient Background Glows -->
        <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-rose-400/10 dark:bg-rose-500/10 rounded-full blur-[120px] pointer-events-none"></div>
        <div class="absolute top-1/3 right-10 w-[300px] h-[300px] bg-brand-400/10 dark:bg-brand-500/10 rounded-full blur-[100px] pointer-events-none"></div>

        <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center">
            <!-- Breadcrumbs -->
            <nav class="flex items-center justify-center gap-2 text-xs font-semibold text-slate-500 dark:text-slate-400 mb-6">
                <a href={homeUrl} class="hover:text-brand-600 dark:hover:text-brand-400 transition-colors">Home</a>
                <i class="fa-solid fa-chevron-right text-[10px] text-slate-400 dark:text-slate-600"></i>
                <span class="text-slate-800 dark:text-slate-200">Sponsor</span>
            </nav>

            <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-rose-50 dark:bg-rose-950/70 border border-rose-200/80 dark:border-rose-900/60 text-rose-700 dark:text-rose-300 text-xs font-bold uppercase tracking-wider mb-4 shadow-sm">
                <i class="fa-solid fa-heart text-rose-500"></i> Community Powered & Non-Profit
            </span>

            <h1 class="text-4xl sm:text-5xl md:text-6xl font-extrabold text-slate-900 dark:text-white tracking-tight mb-4">
                Sponsor <span class="text-gradient">LibreELEC</span>
            </h1>

            <p class="max-w-2xl mx-auto text-base sm:text-lg text-slate-600 dark:text-slate-300 leading-relaxed mb-8">
                LibreELEC software is free and open-source, but running the project is not. We raise funds through public donations and official merchandise to keep servers fast and builds free for everyone.
            </p>

            <!-- Quick Action Buttons -->
            <div class="flex flex-col sm:flex-row items-center justify-center gap-3.5">
                <a
                    href={openCollectiveDonateUrl}
                    target="_blank"
                    rel="noopener"
                    class="w-full sm:w-auto px-7 py-3.5 rounded-xl bg-rose-600 hover:bg-rose-700 text-white font-bold text-sm shadow-lg shadow-rose-500/25 hover:shadow-rose-500/40 hover:-translate-y-0.5 transition-all duration-200 flex items-center justify-center gap-2"
                >
                    <i class="fa-solid fa-heart"></i>
                    <span>Donate on OpenCollective</span>
                </a>
                <a
                    href={merchShopUrl}
                    target="_blank"
                    rel="noopener"
                    class="w-full sm:w-auto px-6 py-3.5 rounded-xl bg-white dark:bg-slate-800 hover:bg-slate-50 dark:hover:bg-slate-700/80 text-slate-800 dark:text-slate-100 font-semibold text-sm border border-slate-200 dark:border-slate-700 hover:border-brand-400 dark:hover:border-brand-500 shadow-sm transition-all duration-200 flex items-center justify-center gap-2"
                >
                    <i class="fa-solid fa-bag-shopping text-brand-600 dark:text-brand-400"></i>
                    <span>Official Merch Store</span>
                </a>
            </div>
        </div>
    </header>

    <!-- Main Content Area -->
    <main class="py-12 md:py-16 bg-slate-50/70 dark:bg-[#0b1329] min-h-screen">
        <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">

            <!-- Transparency & Purpose Highlights -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
                <div class="p-6 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm flex items-start gap-4">
                    <div class="w-11 h-11 rounded-xl bg-brand-50 dark:bg-brand-950/70 text-brand-600 dark:text-brand-400 flex items-center justify-center text-lg shrink-0">
                        <i class="fa-solid fa-users"></i>
                    </div>
                    <div>
                        <h2 class="text-sm font-bold text-slate-900 dark:text-white mb-1">100% Volunteer Driven</h2>
                        <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
                            No corporate owners or paywalls. LibreELEC is run by dedicated open source developers and community volunteers.
                        </p>
                    </div>
                </div>

                <div class="p-6 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm flex items-start gap-4">
                    <div class="w-11 h-11 rounded-xl bg-emerald-50 dark:bg-emerald-950/70 text-emerald-600 dark:text-emerald-400 flex items-center justify-center text-lg shrink-0">
                        <i class="fa-solid fa-chart-line"></i>
                    </div>
                    <div>
                        <h2 class="text-sm font-bold text-slate-900 dark:text-white mb-1">Full Fiscal Transparency</h2>
                        <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
                            All budgets, donations, and expenses are publicly tracked and audited via OpenCollective 501(c)(6) fiscal hosting.
                        </p>
                    </div>
                </div>

                <div class="p-6 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm flex items-start gap-4">
                    <div class="w-11 h-11 rounded-xl bg-purple-50 dark:bg-purple-950/70 text-purple-600 dark:text-purple-400 flex items-center justify-center text-lg shrink-0">
                        <i class="fa-solid fa-microchip"></i>
                    </div>
                    <div>
                        <h2 class="text-sm font-bold text-slate-900 dark:text-white mb-1">Direct Hardware Testing</h2>
                        <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
                            Funds buy test boards, SoC developer kits, TV tuners, and accessories when hardware vendors cannot provide them.
                        </p>
                    </div>
                </div>
            </div>

            <!-- Section: Expenses -->
            <section id="expenses" class="scroll-mt-28">
                <div class="flex items-center justify-between mb-6 pb-3 border-b border-slate-200 dark:border-slate-800">
                    <div class="flex items-center gap-3">
                        <span class="w-8 h-8 rounded-xl bg-brand-600 text-white flex items-center justify-center font-bold text-sm shrink-0">
                            <i class="fa-solid fa-receipt text-xs"></i>
                        </span>
                        <h2 class="text-2xl font-bold text-slate-900 dark:text-white tracking-tight">Project Expenses</h2>
                    </div>
                    <span class="text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Where Funds Go</span>
                </div>

                <p class="text-slate-600 dark:text-slate-300 text-sm sm:text-base leading-relaxed mb-6">
                    Our recurring expenses are hosting for downloads and build servers, and annual domain fees. We also encourage project staff and some regular contributors to expense test hardware when we can't source it for free. We also extend this support to contributors of several downstream and related projects in our ecosystem who collaborate with us, as their testing and efforts often improve things we depend upon.
                </p>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div class="p-5 rounded-xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm">
                        <div class="flex items-center gap-3 mb-2.5">
                            <div class="w-8 h-8 rounded-lg bg-brand-500/10 text-brand-600 dark:text-brand-400 flex items-center justify-center text-sm">
                                <i class="fa-solid fa-server"></i>
                            </div>
                            <h3 class="text-sm font-bold text-slate-900 dark:text-white">Download Mirrors & Build Servers</h3>
                        </div>
                        <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
                            Hosting high-speed global mirror networks distributing multi-terabyte OS images and maintaining continuous automated build servers.
                        </p>
                    </div>

                    <div class="p-5 rounded-xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm">
                        <div class="flex items-center gap-3 mb-2.5">
                            <div class="w-8 h-8 rounded-lg bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 flex items-center justify-center text-sm">
                                <i class="fa-solid fa-tv"></i>
                            </div>
                            <h3 class="text-sm font-bold text-slate-900 dark:text-white">Test Hardware & Dev Devices</h3>
                        </div>
                        <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
                            Purchasing SBCs (Raspberry Pi, Amlogic, Rockchip, Allwinner), DVB tuners, CEC remotes, and audio gear for maintainers when hardware vendors cannot provide them.
                        </p>
                    </div>

                    <div class="p-5 rounded-xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm">
                        <div class="flex items-center gap-3 mb-2.5">
                            <div class="w-8 h-8 rounded-lg bg-purple-500/10 text-purple-600 dark:text-purple-400 flex items-center justify-center text-sm">
                                <i class="fa-solid fa-globe"></i>
                            </div>
                            <h3 class="text-sm font-bold text-slate-900 dark:text-white">Domains & Infrastructure Services</h3>
                        </div>
                        <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
                            Annual registration for project domains, DNS routing services, security certificates, and backend tooling for project maintenance.
                        </p>
                    </div>

                    <div class="p-5 rounded-xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm">
                        <div class="flex items-center gap-3 mb-2.5">
                            <div class="w-8 h-8 rounded-lg bg-amber-500/10 text-amber-600 dark:text-amber-400 flex items-center justify-center text-sm">
                                <i class="fa-solid fa-hands-holding-circle"></i>
                            </div>
                            <h3 class="text-sm font-bold text-slate-900 dark:text-white">Collaborative Ecosystem Support</h3>
                        </div>
                        <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
                            Supporting upstream Linux kernel developers, Kodi contributors, and DRM/V4L2 driver authors whose testing and code directly improves LibreELEC.
                        </p>
                    </div>
                </div>
            </section>

            <!-- Section: Donations & OpenCollective -->
            <section id="donations" class="scroll-mt-28">
                <div class="flex items-center justify-between mb-6 pb-3 border-b border-slate-200 dark:border-slate-800">
                    <div class="flex items-center gap-3">
                        <span class="w-8 h-8 rounded-xl bg-rose-600 text-white flex items-center justify-center font-bold text-sm shrink-0">
                            <i class="fa-solid fa-hand-holding-dollar text-xs"></i>
                        </span>
                        <h2 class="text-2xl font-bold text-slate-900 dark:text-white tracking-tight">Donations & OpenCollective</h2>
                    </div>
                    <span class="text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">How to Donate</span>
                </div>

                <div class="p-6 sm:p-8 rounded-3xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm space-y-6">
                    <p class="text-slate-600 dark:text-slate-300 text-sm sm:text-base leading-relaxed">
                        We accept donations through <strong>OpenCollective</strong> which helps us to manage funds transparently and provide visible recognition to our personal and corporate supporters.
                    </p>

                    <!-- Big Action Box -->
                    <div class="p-6 rounded-2xl bg-gradient-to-r from-rose-50/80 to-amber-50/60 dark:from-rose-950/40 dark:to-slate-800/80 border border-rose-200/80 dark:border-rose-900/60 flex flex-col sm:flex-row items-center justify-between gap-5">
                        <div class="flex items-center gap-4">
                            <div class="w-14 h-14 rounded-2xl bg-rose-500/15 border border-rose-500/30 text-rose-600 dark:text-rose-400 flex items-center justify-center text-2xl shrink-0">
                                <i class="fa-solid fa-heart"></i>
                            </div>
                            <div>
                                <h3 class="text-base font-bold text-slate-900 dark:text-white">Make a One-Time or Monthly Contribution</h3>
                                <p class="text-xs text-slate-600 dark:text-slate-300 mt-1">
                                    Support via credit card, PayPal, bank transfer, or corporate sponsorship through OpenCollective.
                                </p>
                            </div>
                        </div>
                        <div class="flex flex-col sm:flex-row items-center gap-2.5 w-full sm:w-auto shrink-0">
                            <a
                                href={openCollectiveDonateUrl}
                                target="_blank"
                                rel="noopener"
                                class="w-full sm:w-auto px-6 py-3 rounded-xl bg-rose-600 hover:bg-rose-700 text-white font-bold text-xs shadow-md shadow-rose-500/25 hover:shadow-rose-500/40 transition-all flex items-center justify-center gap-2 text-center"
                            >
                                <i class="fa-solid fa-heart"></i> Donate on OpenCollective
                            </a>
                            <a
                                href={openCollectiveUrl}
                                target="_blank"
                                rel="noopener"
                                class="w-full sm:w-auto px-4 py-3 rounded-xl bg-white dark:bg-slate-800 hover:bg-slate-50 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 border border-slate-200 dark:border-slate-700 font-semibold text-xs transition-all flex items-center justify-center gap-1.5"
                                title="View public balance and transactions"
                            >
                                <i class="fa-solid fa-arrow-up-right-from-square text-[10px]"></i> View Public Budget
                            </a>
                        </div>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 pt-2">
                        <!-- Forum Tag Box -->
                        <div class="p-5 rounded-2xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700/80">
                            <h4 class="font-bold text-slate-900 dark:text-white text-sm mb-1.5 flex items-center gap-2">
                                <i class="fa-solid fa-certificate text-amber-500"></i> Forum Supporter Tag
                            </h4>
                            <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
                                Personal donors can request a donor tag for their <a href={forumUrl} target="_blank" rel="noopener" class="text-brand-600 dark:text-brand-400 hover:underline">community forum account</a> by sending an email with donation confirmation details to our team.
                            </p>
                        </div>

                        <!-- PayPal Migration Notice -->
                        <div class="p-5 rounded-2xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700/80">
                            <h4 class="font-bold text-slate-900 dark:text-white text-sm mb-1.5 flex items-center gap-2">
                                <i class="fa-brands fa-paypal text-sky-500"></i> Switching from Legacy PayPal
                            </h4>
                            <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
                                If you have a repeating donation on our legacy PayPal account, we would love you to cancel it and switch over to OpenCollective for better transparency and lower fees.
                            </p>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Section: Merchandise -->
            <section id="merchandise" class="scroll-mt-28">
                <div class="flex items-center justify-between mb-6 pb-3 border-b border-slate-200 dark:border-slate-800">
                    <div class="flex items-center gap-3">
                        <span class="w-8 h-8 rounded-xl bg-amber-600 text-white flex items-center justify-center font-bold text-sm shrink-0">
                            <i class="fa-solid fa-shirt text-xs"></i>
                        </span>
                        <h2 class="text-2xl font-bold text-slate-900 dark:text-white tracking-tight">Official Merchandise</h2>
                    </div>
                    <span class="text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">LibreELEC Swag</span>
                </div>

                <div class="p-6 sm:p-8 rounded-3xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm flex flex-col md:flex-row items-center justify-between gap-6">
                    <div class="space-y-3 max-w-xl">
                        <p class="text-slate-600 dark:text-slate-300 text-sm sm:text-base leading-relaxed">
                            The project sells project logo themed t-shirts, hoodies, mugs, stickers, and more from our official merch store with all profits contributing directly to project operations.
                        </p>
                        <div class="flex flex-wrap gap-2 text-xs font-medium text-slate-500 dark:text-slate-400">
                            <span class="px-2.5 py-1 rounded-md bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700">T-Shirts & Hoodies</span>
                            <span class="px-2.5 py-1 rounded-md bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700">Coffee Mugs</span>
                            <span class="px-2.5 py-1 rounded-md bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700">Die-Cut Stickers</span>
                            <span class="px-2.5 py-1 rounded-md bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700">Global Shipping</span>
                        </div>
                    </div>
                    <a
                        href={merchShopUrl}
                        target="_blank"
                        rel="noopener"
                        class="shrink-0 px-6 py-3.5 rounded-xl bg-brand-600 hover:bg-brand-700 text-white font-bold text-sm shadow-md shadow-brand-500/20 hover:shadow-brand-500/35 hover:-translate-y-0.5 transition-all duration-200 flex items-center gap-2"
                    >
                        <i class="fa-solid fa-arrow-up-right-from-square text-xs"></i>
                        <span>Visit LibreELEC Shop</span>
                    </a>
                </div>
            </section>

            <!-- Other Ways to Help -->
            <section class="p-6 sm:p-8 rounded-3xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm">
                <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-2 flex items-center gap-2">
                    <i class="fa-solid fa-handshake-angle text-brand-600 dark:text-brand-400"></i> Other Ways to Help
                </h3>
                <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed mb-6">
                    Donations and merch purchases are wonderful, but you can also support LibreELEC with your skills and time:
                </p>

                <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                    <a href={githubUrl} target="_blank" rel="noopener" class="p-4 rounded-xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700/80 hover:border-brand-400 dark:hover:border-brand-500 transition-all group">
                        <div class="flex items-center gap-2 text-slate-900 dark:text-white font-bold text-xs mb-1 group-hover:text-brand-600 dark:group-hover:text-brand-400">
                            <i class="fa-brands fa-github text-sm"></i> Code & Packaging
                        </div>
                        <p class="text-[11px] text-slate-500 dark:text-slate-400 leading-relaxed">
                            Submit bug fixes, bump packages, or port support for new single-board computers on GitHub.
                        </p>
                    </a>

                    <a href={forumUrl} target="_blank" rel="noopener" class="p-4 rounded-xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700/80 hover:border-brand-400 dark:hover:border-brand-500 transition-all group">
                        <div class="flex items-center gap-2 text-slate-900 dark:text-white font-bold text-xs mb-1 group-hover:text-brand-600 dark:group-hover:text-brand-400">
                            <i class="fa-solid fa-comments text-sm"></i> Community Support
                        </div>
                        <p class="text-[11px] text-slate-500 dark:text-slate-400 leading-relaxed">
                            Answer user questions and share troubleshooting tips with fellow users on our forum.
                        </p>
                    </a>

                    <a href={wikiUrl} target="_blank" rel="noopener" class="p-4 rounded-xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700/80 hover:border-brand-400 dark:hover:border-brand-500 transition-all group">
                        <div class="flex items-center gap-2 text-slate-900 dark:text-white font-bold text-xs mb-1 group-hover:text-brand-600 dark:group-hover:text-brand-400">
                            <i class="fa-solid fa-book-open text-sm"></i> Documentation
                        </div>
                        <p class="text-[11px] text-slate-500 dark:text-slate-400 leading-relaxed">
                            Help maintain installation guides, hardware compatibility lists, and tips on the wiki.
                        </p>
                    </a>
                </div>
            </section>

        </div>
    </main>
</Layout>
