---
import Layout from '../layouts/Layout.astro';
import TvPreview from '../components/TvPreview.astro';
import Features from '../components/Features.astro';
import Downloads from '../components/Downloads.astro';
import UsbCreator from '../components/UsbCreator.astro';
import NewsSection from '../components/NewsSection.astro';
---

<Layout>
    <!-- Hero & Interactive TV Showcase -->
    <TvPreview />

    <!-- Performance Stats & Feature Grid -->
    <Features />

    <!-- Download Platforms Matrix (Alpine.js Filtering) -->
    <Downloads />

    <!-- Official USB-SD Creator Tool -->
    <UsbCreator />

    <!-- Latest News & Releases (Dynamic Content Collection) -->
    <NewsSection />

    <!-- Community & Contribution CTA -->
    <section class="py-20 relative">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="glass-card rounded-3xl p-8 sm:p-12 text-center border border-slate-200 relative overflow-hidden bg-gradient-to-b from-white to-sky-50/50">
                <div class="max-w-2xl mx-auto relative z-10">
                    <div class="w-16 h-16 rounded-2xl bg-brand-50 border border-brand-200 text-brand-600 flex items-center justify-center text-3xl mx-auto mb-6 shadow-sm">
                        <i class="fa-solid fa-users"></i>
                    </div>
                    <h2 class="text-3xl font-extrabold text-slate-900 mb-4">Need Help or Want to Contribute?</h2>
                    <p class="text-slate-600 text-sm sm:text-base mb-8">
                        Join our active community forum! Ask questions, report hardware compatibility, or help translate and build add-ons.
                    </p>
                    <div class="flex flex-wrap items-center justify-center gap-4">
                        <a href="https://forum.libreelec.tv" target="_blank" rel="noopener" class="px-8 py-3.5 rounded-xl bg-brand-600 hover:bg-brand-700 text-white font-bold text-sm shadow-md shadow-brand-500/20 transition-all">
                            Visit Community Forum
                        </a>
                        <a href="https://github.com/LibreELEC/LibreELEC.tv" target="_blank" rel="noopener" class="px-8 py-3.5 rounded-xl bg-white hover:bg-slate-50 text-slate-800 font-semibold text-sm border border-slate-300 flex items-center gap-2 shadow-sm transition-all">
                            <i class="fa-brands fa-github text-lg text-slate-900"></i> GitHub Repository
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>
</Layout>
