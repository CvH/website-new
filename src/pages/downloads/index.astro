---
import Layout from '../../layouts/Layout.astro';
import UsbCreator from '../../components/UsbCreator.astro';
import DownloadModal from '../../components/DownloadModal.astro';
import Toast from '../../components/Toast.astro';
import { getClientMatrixData, getLatestVersion } from '../../utils/downloads';

const data = getClientMatrixData();
const latestVersion = getLatestVersion();

const clientDataJson = JSON.stringify(data);
---

<Layout
    title={`Download LibreELEC ${latestVersion.name} - Official Releases & Disk Images`}
    description={`Download official LibreELEC images for Raspberry Pi 5/4/3, Generic x86_64 PC, Rockchip, Amlogic, and Allwinner devices.`}
>
    <!-- Downloads Page Header -->
    <header class="relative pt-32 pb-16 md:pt-40 md:pb-20 overflow-hidden hero-gradient border-b border-slate-200">
        <!-- Background decorative ambient glows -->
        <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-brand-400/10 rounded-full blur-[120px] pointer-events-none"></div>
        <div class="absolute top-1/3 right-10 w-[300px] h-[300px] bg-emerald-400/10 rounded-full blur-[100px] pointer-events-none"></div>

        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center">
            <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-brand-50 border border-brand-200/80 text-brand-700 text-xs font-bold uppercase tracking-wider mb-4 shadow-sm">
                <i class="fa-solid fa-download"></i> Official Releases & Disk Images
            </span>
            <h1 class="text-4xl sm:text-6xl font-extrabold text-slate-900 tracking-tight mb-4">
                Download <span class="text-gradient">LibreELEC</span>
            </h1>
            <p class="max-w-2xl mx-auto text-base sm:text-lg text-slate-600 leading-relaxed mb-8">
                Choose your hardware platform and release version below to download raw installer images (<code class="font-mono text-xs bg-slate-100 px-1.5 py-0.5 rounded text-slate-800">.img.gz</code>), update files (<code class="font-mono text-xs bg-slate-100 px-1.5 py-0.5 rounded text-slate-800">.tar</code>), or verify SHA256 checksums.
            </p>

            <div class="flex items-center justify-center gap-4 text-xs font-semibold text-slate-500">
                <a href="#creator" class="inline-flex items-center gap-1.5 text-brand-600 hover:text-brand-700 hover:underline">
                    <i class="fa-solid fa-compact-disc"></i> Prefer an automatic installer? Jump to USB-SD Creator &darr;
                </a>
            </div>
        </div>
    </header>

    <!-- Main Interactive Download Hub Container (Alpine.js) -->
    <main
        class="py-12 bg-slate-50/70 min-h-screen"
        x-data={`{
            data: ${clientDataJson},
            selectedVersion: '${latestVersion.id}',
            selectedPlatform: 'all',
            searchQuery: '',
            showAllVersions: false,

            getStatusType(ver) {
                if (ver.status === 'latest') return 'latest';
                if (ver.status === 'old' || ver.status === 'stable') return 'old';
                return 'legacy';
            },

            getStatusLabel(ver) {
                if (ver.status === 'latest') return 'Latest';
                if (ver.status === 'old' || ver.status === 'stable') return 'Old Version';
                if (ver.status === 'legacy') return 'Legacy';
                return ver.status;
            },

            get displayedVersions() {
                if (this.showAllVersions) {
                    return this.data.versions;
                }
                return this.data.versions.filter(v => v.status === 'latest' || v.id === this.selectedVersion);
            },

            getButtonClasses(ver) {
                const isSelected = this.selectedVersion === ver.id;
                const type = this.getStatusType(ver);
                if (isSelected) {
                    if (type === 'latest') {
                        return 'bg-emerald-600 text-white shadow-md shadow-emerald-600/25 ring-2 ring-emerald-500/40 border border-emerald-600';
                    }
                    if (type === 'old') {
                        return 'bg-amber-500 text-white shadow-md shadow-amber-500/25 ring-2 ring-amber-400/40 border border-amber-500';
                    }
                    return 'bg-slate-700 text-white shadow-md shadow-slate-700/25 ring-2 ring-slate-500/40 border border-slate-700';
                }
                if (type === 'latest') {
                    return 'bg-emerald-50/80 text-emerald-950 hover:bg-emerald-100/70 border border-emerald-300 hover:border-emerald-400';
                }
                if (type === 'old') {
                    return 'bg-amber-50/80 text-amber-950 hover:bg-amber-100/70 border border-amber-300 hover:border-amber-400';
                }
                return 'bg-slate-50 text-slate-700 hover:text-slate-900 border border-slate-300 hover:border-slate-400 hover:bg-slate-100';
            },

            getStaticBadgeClasses(ver) {
                const type = this.getStatusType(ver);
                if (type === 'latest') {
                    return 'bg-emerald-100 text-emerald-800 border border-emerald-300/80';
                }
                if (type === 'old') {
                    return 'bg-amber-100 text-amber-900 border border-amber-300/80';
                }
                return 'bg-slate-200 text-slate-700 border border-slate-300/80';
            },

            getBadgeClasses(ver) {
                if (this.selectedVersion === ver.id) {
                    return 'bg-white/20 text-white border border-white/20';
                }
                return this.getStaticBadgeClasses(ver);
            },

            get activeVersionInfo() {
                return this.data.versions.find(v => v.id === this.selectedVersion) || this.data.versions[0];
            },

            get activePlatformInfo() {
                if (this.selectedPlatform === 'all') return null;
                return this.data.platforms.find(p => p.id === this.selectedPlatform);
            },

            get filteredDevices() {
                const q = this.searchQuery.trim().toLowerCase();
                return this.data.devices.filter(item => {
                    const matchVersion = item.versionId === this.selectedVersion;
                    const matchPlatform = this.selectedPlatform === 'all' || item.platformId === this.selectedPlatform;
                    const matchSearch = !q ||
                        item.deviceName.toLowerCase().includes(q) ||
                        item.platformName.toLowerCase().includes(q) ||
                        (item.chipset && item.chipset.toLowerCase().includes(q)) ||
                        (item.features && item.features.toLowerCase().includes(q));
                    return matchVersion && matchPlatform && matchSearch;
                });
            }
        }`}
    >
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

            <!-- Controls Panel: Version Selector + Active Version Metadata Card -->
            <div class="glass-card rounded-3xl p-6 sm:p-8 border border-slate-200/90 shadow-sm mb-10">
                <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-6 pb-6 border-b border-slate-200">
                    <div>
                        <span class="text-xs font-bold uppercase tracking-wider text-slate-500 block mb-2">1. Select Release Version</span>
                        <!-- Version Pills -->
                        <div class="flex flex-wrap items-center gap-2">
                            <template x-for="ver in displayedVersions" :key="ver.id">
                                <button
                                    type="button"
                                    @click="selectedVersion = ver.id"
                                    class="px-4 py-2 rounded-xl text-xs sm:text-sm font-bold transition-all flex items-center gap-2 shadow-sm"
                                    :class="getButtonClasses(ver)"
                                >
                                    <span x-text="'v' + ver.name"></span>
                                    <span
                                        class="px-2 py-0.5 rounded-full text-[10px] uppercase font-extrabold tracking-wide"
                                        :class="getBadgeClasses(ver)"
                                        x-text="getStatusLabel(ver)"
                                    ></span>
                                </button>
                            </template>

                            <!-- Show All / Show Less Toggle Button -->
                            <button
                                type="button"
                                x-show="data.versions.length > 1"
                                @click="showAllVersions = !showAllVersions"
                                class="px-3.5 py-2 rounded-xl text-xs sm:text-sm font-semibold transition-all flex items-center gap-2 shadow-sm bg-white hover:bg-slate-50 text-slate-700 hover:text-slate-900 border border-slate-200 hover:border-slate-300"
                                :aria-expanded="showAllVersions"
                                aria-label="Toggle all release versions"
                                id="toggle-all-versions-btn"
                            >
                                <span x-text="showAllVersions ? 'Show less' : 'Show all'"></span>
                                <span
                                    x-show="!showAllVersions"
                                    class="px-1.5 py-0.2 rounded-full text-[10px] font-bold bg-slate-100 text-slate-600 border border-slate-200 font-mono"
                                    x-text="'+' + (data.versions.length - displayedVersions.length)"
                                ></span>
                                <i
                                    class="fa-solid text-[10px] text-slate-400 transition-transform duration-200"
                                    :class="showAllVersions ? 'fa-chevron-up' : 'fa-chevron-down'"
                                ></i>
                            </button>
                        </div>
                    </div>

                    <!-- Instant Search Bar -->
                    <div class="w-full lg:w-80">
                        <span class="text-xs font-bold uppercase tracking-wider text-slate-500 block mb-2">Quick Search Hardware</span>
                        <div class="relative">
                            <i class="fa-solid fa-magnifying-glass absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
                            <input
                                type="text"
                                x-model="searchQuery"
                                placeholder="Search by board, SoC, or PC..."
                                class="w-full pl-9 pr-8 py-2.5 rounded-xl border border-slate-200 bg-white text-xs text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500 transition-all shadow-sm"
                            />
                            <button
                                type="button"
                                x-show="searchQuery.length > 0"
                                @click="searchQuery = ''"
                                class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-600 text-xs"
                                aria-label="Clear search"
                            >
                                <i class="fa-solid fa-xmark"></i>
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Active Version Specifications Ribbon -->
                <div class="pt-6 flex flex-col md:flex-row md:items-center justify-between gap-4">
                    <div class="flex flex-wrap items-center gap-4 sm:gap-6 text-xs text-slate-700">
                        <div class="flex items-center gap-2">
                            <span class="text-slate-400 font-medium">Status:</span>
                            <span
                                class="px-2.5 py-0.5 rounded-full text-[10px] uppercase font-extrabold tracking-wide"
                                :class="getStaticBadgeClasses(activeVersionInfo)"
                                x-text="getStatusLabel(activeVersionInfo)"
                            ></span>
                        </div>
                        <div class="flex items-center gap-2">
                            <span class="text-slate-400 font-medium">Release Date:</span>
                            <span class="font-bold text-slate-900 font-mono" x-text="activeVersionInfo.releaseDate"></span>
                        </div>
                        <div class="flex items-center gap-2">
                            <span class="text-slate-400 font-medium">Kodi Version:</span>
                            <span class="px-2 py-0.5 rounded-md bg-blue-50 text-blue-700 font-bold border border-blue-200" x-text="activeVersionInfo.kodiVersion"></span>
                        </div>
                        <div class="flex items-center gap-2">
                            <span class="text-slate-400 font-medium">Linux Kernel:</span>
                            <span class="px-2 py-0.5 rounded-md bg-emerald-50 text-emerald-700 font-bold font-mono border border-emerald-200" x-text="activeVersionInfo.kernelVersion"></span>
                        </div>
                    </div>
                    <p class="text-xs text-slate-500 italic max-w-lg" x-text="activeVersionInfo.description || ''"></p>
                </div>
            </div>

            <!-- 2. Platform Category Filters -->
            <div class="flex flex-wrap items-center justify-center gap-2 sm:gap-3 mb-10">
                <button
                    type="button"
                    @click="selectedPlatform = 'all'"
                    class="px-4 py-2.5 rounded-xl font-bold text-xs sm:text-sm transition-all"
                    :class="selectedPlatform === 'all'
                        ? 'bg-slate-900 text-white shadow-md'
                        : 'text-slate-600 hover:text-slate-900 bg-white border border-slate-200 hover:border-slate-300 shadow-sm'"
                >
                    <i class="fa-solid fa-layer-group mr-1.5 text-slate-400"></i> All Hardware
                </button>

                <template x-for="plat in data.platforms" :key="plat.id">
                    <button
                        type="button"
                        @click="selectedPlatform = plat.id"
                        class="px-4 py-2.5 rounded-xl font-bold text-xs sm:text-sm transition-all flex items-center gap-2"
                        :class="selectedPlatform === plat.id
                            ? 'bg-brand-600 text-white shadow-md shadow-brand-500/20'
                            : 'text-slate-600 hover:text-slate-900 bg-white border border-slate-200 hover:border-slate-300 shadow-sm'"
                    >
                        <i :class="plat.icon"></i>
                        <span x-text="plat.name"></span>
                    </button>
                </template>
            </div>

            <!-- Platform Specific Note (e.g. NXP nightly note) -->
            <template x-if="activePlatformInfo && activePlatformInfo.note">
                <div class="mb-8 p-5 rounded-2xl bg-amber-50 border border-amber-200 flex items-start gap-4">
                    <div class="w-8 h-8 rounded-xl bg-amber-100 text-amber-700 flex items-center justify-center shrink-0 mt-0.5">
                        <i class="fa-solid fa-triangle-exclamation"></i>
                    </div>
                    <div>
                        <h4 class="text-sm font-bold text-amber-900 mb-1" x-text="activePlatformInfo.name + ' Notice'"></h4>
                        <p class="text-xs text-amber-800 leading-relaxed" x-text="activePlatformInfo.note"></p>
                    </div>
                </div>
            </template>

            <!-- Results Count Bar -->
            <div class="flex items-center justify-between mb-6 text-xs text-slate-500 px-1 font-medium">
                <div class="flex items-center gap-2 flex-wrap">
                    <span>Showing <strong class="text-slate-900" x-text="filteredDevices.length"></strong> compatible devices for</span>
                    <strong class="font-mono text-slate-900 text-sm" x-text="'LibreELEC ' + activeVersionInfo.name"></strong>
                    <span
                        class="px-2 py-0.5 rounded-full text-[10px] uppercase font-extrabold tracking-wide"
                        :class="getStaticBadgeClasses(activeVersionInfo)"
                        x-text="getStatusLabel(activeVersionInfo)"
                    ></span>
                </div>
                <template x-if="searchQuery">
                    <button @click="searchQuery = ''" type="button" class="text-brand-600 hover:underline">
                        Clear search filter
                    </button>
                </template>
            </div>

            <!-- Dynamic Device Cards Grid -->
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-16">
                <template x-for="item in filteredDevices" :key="item.deviceId + '-' + item.versionId">
                    <div class="dl-card glass-card rounded-2xl p-6 border border-slate-200 hover:border-brand-300 flex flex-col justify-between transition-all duration-200 hover:shadow-md bg-white">
                        <div>
                            <!-- Header badge & version -->
                            <div class="flex items-center justify-between mb-4">
                                <span
                                    class="px-2.5 py-1 rounded-full text-[11px] font-bold border flex items-center gap-1.5"
                                    :class="item.badgeColor === 'red' ? 'bg-red-50 text-red-700 border-red-200' :
                                            (item.badgeColor === 'blue' ? 'bg-blue-50 text-blue-700 border-blue-200' :
                                            (item.badgeColor === 'emerald' ? 'bg-emerald-50 text-emerald-700 border-emerald-200' :
                                            (item.badgeColor === 'purple' ? 'bg-purple-50 text-purple-700 border-purple-200' :
                                            (item.badgeColor === 'amber' ? 'bg-amber-50 text-amber-700 border-amber-200' : 'bg-slate-50 text-slate-700 border-slate-200'))))"
                                >
                                    <i :class="item.icon"></i>
                                    <span x-text="item.platformName"></span>
                                </span>
                                <span class="text-[11px] font-mono font-semibold text-slate-500 bg-slate-100 px-2 py-0.5 rounded" x-text="'v' + item.downloadVersion"></span>
                            </div>

                            <!-- Hardware Title & Chipset -->
                            <h3 class="text-lg font-bold text-slate-900" :class="item.chipset ? 'mb-1' : 'mb-4'" x-text="item.deviceName"></h3>
                            <template x-if="item.chipset">
                                <p class="text-[11px] text-slate-500 font-mono mb-4" x-text="item.chipset"></p>
                            </template>
                        </div>

                        <!-- Actions & Download Links -->
                        <div class="space-y-3 pt-4 border-t border-slate-100">
                            <!-- Direct Image Download (Triggers modal with direct link fallback) -->
                            <button
                                type="button"
                                @click="$store.ui.openDownloadModal(item.deviceName, item.imageFileName, item.imageUrl, item.mirrorListUrl)"
                                class="w-full py-3 rounded-xl bg-brand-600 hover:bg-brand-700 text-white font-bold text-xs flex items-center justify-center gap-2 transition-all shadow-sm hover:shadow-md"
                            >
                                <i class="fa-solid fa-download"></i> Direct Image Download (.img.gz)
                            </button>

                            <!-- Secondary links: Tarball update & Mirrorlist / SHA256 -->
                            <div class="flex items-center justify-between text-[11px] font-mono pt-1 text-slate-500">
                                <a
                                    :href="item.updateUrl"
                                    class="text-slate-600 hover:text-brand-600 font-medium flex items-center gap-1"
                                    title="Manual update file for .update folder"
                                >
                                    <i class="fa-solid fa-file-zipper text-[10px]"></i> Update File (.tar)
                                </a>

                                <a
                                    :href="item.mirrorListUrl"
                                    target="_blank"
                                    rel="noopener"
                                    class="text-slate-600 hover:text-brand-600 font-medium flex items-center gap-1"
                                    title="View SHA256 hash and mirrorlist"
                                >
                                    <i class="fa-solid fa-shield-halved text-[10px]"></i> SHA256 Checksum
                                </a>
                            </div>
                        </div>
                    </div>
                </template>
            </div>

            <!-- Empty Search State -->
            <div x-show="filteredDevices.length === 0" class="text-center py-16 bg-white rounded-3xl border border-slate-200 p-8 shadow-sm">
                <div class="w-16 h-16 rounded-2xl bg-slate-100 text-slate-400 flex items-center justify-center text-2xl mx-auto mb-4">
                    <i class="fa-solid fa-box-open"></i>
                </div>
                <h3 class="text-lg font-bold text-slate-900 mb-1">No matching hardware found</h3>
                <p class="text-xs text-slate-500 max-w-md mx-auto mb-4">
                    We couldn't find any images matching "<span class="font-semibold text-slate-800" x-text="searchQuery"></span>" in LibreELEC <span class="font-semibold text-slate-800" x-text="activeVersionInfo.name"></span>.
                </p>
                <button
                    type="button"
                    @click="searchQuery = ''; selectedPlatform = 'all'"
                    class="px-4 py-2 rounded-xl bg-slate-900 hover:bg-slate-800 text-white font-bold text-xs"
                >
                    Reset all filters
                </button>
            </div>

        </div>
    </main>

    <!-- Official USB-SD Creator Tool Section -->
    <UsbCreator />

    <!-- Download Modal & Toast Notification Components -->
    <DownloadModal />
    <Toast />
</Layout>
