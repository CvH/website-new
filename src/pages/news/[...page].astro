---
import Layout from '../../layouts/Layout.astro';
import PostCard from '../../components/PostCard.astro';
import { getSortedPosts, type EnrichedPost } from '../../utils/posts';
import type { GetStaticPathsOptions, Page } from 'astro';

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const posts = await getSortedPosts();
  return paginate(posts, { pageSize: 12 });
}

interface Props {
  page: Page<EnrichedPost>;
}

const { page } = Astro.props;
const posts = page.data;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const homeUrl = base || '/';
---

<Layout title={`News Archive (Page ${page.currentPage}) - LibreELEC`} description="Browse all LibreELEC release announcements, dev updates, and community news.">
    <div class="pt-32 pb-24 bg-slate-50 min-h-screen" x-data="{ filter: 'all' }">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <!-- Header -->
            <div class="mb-12">
                <nav class="flex items-center gap-2 text-xs font-semibold text-slate-500 mb-4">
                    <a href={homeUrl} class="hover:text-brand-600 transition-colors">Home</a>
                    <i class="fa-solid fa-chevron-right text-[10px] text-slate-400"></i>
                    <span class="text-slate-800">News Archive</span>
                </nav>
                <div class="flex flex-col md:flex-row md:items-end justify-between gap-6">
                    <div>
                        <span class="text-xs font-bold text-brand-600 uppercase tracking-widest mb-2 block">All Releases & Articles</span>
                        <h1 class="text-3xl sm:text-5xl font-extrabold text-slate-900 tracking-tight">News Archive</h1>
                        <p class="mt-2 text-slate-600 text-sm">
                            Showing page {page.currentPage} of {page.lastPage} ({page.total} total articles from 2016 to 2025)
                        </p>
                    </div>

                    <!-- Category Filter Tabs -->
                    <div class="flex items-center gap-2">
                        <button
                            type="button"
                            @click="filter = 'all'"
                            class="news-tab px-4 py-2 rounded-lg text-xs font-semibold shadow-sm transition-all"
                            :class="filter === 'all' ? 'bg-brand-600 text-white' : 'text-slate-600 hover:text-slate-900 bg-white border border-slate-200'"
                        >
                            All ({posts.length})
                        </button>
                        <button
                            type="button"
                            @click="filter = 'release'"
                            class="news-tab px-4 py-2 rounded-lg text-xs font-semibold shadow-sm transition-all"
                            :class="filter === 'release' ? 'bg-brand-600 text-white' : 'text-slate-600 hover:text-slate-900 bg-white border border-slate-200'"
                        >
                            Releases
                        </button>
                        <button
                            type="button"
                            @click="filter = 'dev'"
                            class="news-tab px-4 py-2 rounded-lg text-xs font-semibold shadow-sm transition-all"
                            :class="filter === 'dev' ? 'bg-brand-600 text-white' : 'text-slate-600 hover:text-slate-900 bg-white border border-slate-200'"
                        >
                            Development
                        </button>
                    </div>
                </div>
            </div>

            <!-- Posts Grid -->
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                {posts.map((post) => (
                    <PostCard enrichedPost={post} />
                ))}
            </div>

            <!-- Pagination Bar -->
            {page.lastPage > 1 && (
                <div class="mt-16 pt-8 border-t border-slate-200 flex items-center justify-between">
                    <div>
                        {page.url.prev ? (
                            <a
                                href={page.url.prev}
                                class="px-5 py-2.5 rounded-xl bg-white hover:bg-slate-50 text-slate-800 font-bold text-xs border border-slate-200 shadow-sm flex items-center gap-2 transition-all"
                            >
                                <i class="fa-solid fa-arrow-left"></i> Previous Page
                            </a>
                        ) : (
                            <span class="px-5 py-2.5 rounded-xl bg-slate-100 text-slate-400 font-bold text-xs cursor-not-allowed flex items-center gap-2">
                                <i class="fa-solid fa-arrow-left"></i> Previous Page
                            </span>
                        )}
                    </div>

                    <div class="text-xs font-mono font-semibold text-slate-600">
                        Page <span class="text-brand-600 font-bold">{page.currentPage}</span> of {page.lastPage}
                    </div>

                    <div>
                        {page.url.next ? (
                            <a
                                href={page.url.next}
                                class="px-5 py-2.5 rounded-xl bg-white hover:bg-slate-50 text-slate-800 font-bold text-xs border border-slate-200 shadow-sm flex items-center gap-2 transition-all"
                            >
                                Next Page <i class="fa-solid fa-arrow-right"></i>
                            </a>
                        ) : (
                            <span class="px-5 py-2.5 rounded-xl bg-slate-100 text-slate-400 font-bold text-xs cursor-not-allowed flex items-center gap-2">
                                Next Page <i class="fa-solid fa-arrow-right"></i>
                            </span>
                        )}
                    </div>
                </div>
            )}
        </div>
    </div>
</Layout>
