---
import type { EnrichedPost } from '../utils/posts';

interface Props {
  enrichedPost: EnrichedPost;
}

const { enrichedPost } = Astro.props;
const { post, formattedDate, url, category, categoryLabel } = enrichedPost;
const author = post.data.author || 'LibreELEC Team';
const description = post.data.description || 'LibreELEC updates, improvements, and system release information.';
---

<article
    class="news-card glass-card rounded-2xl overflow-hidden border border-slate-200 flex flex-col justify-between"
    data-ncat={category}
    x-show={`filter === 'all' || filter === '${category}'`}
    x-transition
>
    <div class="p-6">
        <div class="flex items-center justify-between text-xs text-slate-500 mb-3">
            {category === 'release' ? (
                <span class="px-2.5 py-1 rounded-md bg-brand-50 text-brand-700 font-bold border border-brand-200">
                    {categoryLabel}
                </span>
            ) : (
                <span class="px-2.5 py-1 rounded-md bg-amber-50 text-amber-700 font-bold border border-amber-200">
                    {categoryLabel}
                </span>
            )}
            <span class="font-medium font-mono text-[11px] text-slate-500">{formattedDate}</span>
        </div>
        <h3 class="text-xl font-bold text-slate-900 mb-3 hover:text-brand-600 transition-colors">
            <a href={url}>{post.data.title}</a>
        </h3>
        <p class="text-slate-600 text-xs line-clamp-3 leading-relaxed mb-4">
            {description}
        </p>
    </div>
    <div class="px-6 py-4 border-t border-slate-100 bg-slate-50/60 flex items-center justify-between text-xs">
        <span class="text-slate-600 font-medium">
            <i class="fa-solid fa-user text-brand-600 mr-1"></i> {author}
        </span>
        <a href={url} class="text-brand-600 font-bold hover:underline flex items-center gap-1">
            Read Post <i class="fa-solid fa-arrow-right text-[10px]"></i>
        </a>
    </div>
</article>
