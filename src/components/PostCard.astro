---
import type { EnrichedPost } from '../utils/posts';

interface Props {
  enrichedPost: EnrichedPost;
  featured?: boolean;
}

const { enrichedPost, featured = false } = Astro.props;
const { post, formattedDate, url, category, categoryLabel } = enrichedPost;
const author = post.data.author || 'LibreELEC Team';

// Extract first paragraph, first headline, and headline content from post body
interface PostDetails {
  firstParagraph: string;
  firstHeadline: string;
  headlineBullets: string[];
  headlineParagraph: string;
}

function extractPostDetails(body?: string): PostDetails {
  if (!body) {
    return { firstParagraph: '', firstHeadline: '', headlineBullets: [], headlineParagraph: '' };
  }

  // Remove HTML comments and markdown images
  const cleanBody = body
    .replace(/<!--[\s\S]*?-->/g, '')
    .replace(/!\[.*?\]\(.*?\)/g, '')
    .trim();

  // Find the first markdown heading (e.g. ## Heading)
  const headingMatch = cleanBody.match(/(?:^|\n)(#{1,6})\s+([^\n]+)/);

  let introPart = '';
  let headline = '';
  let sectionContent = '';

  if (headingMatch) {
    const headingIndex = headingMatch.index! + (headingMatch[0].startsWith('\n') ? 1 : 0);
    introPart = cleanBody.slice(0, headingIndex).trim();
    headline = headingMatch[2].trim();

    const afterHeading = cleanBody.slice(headingIndex + headingMatch[0].length).trim();
    const nextHeadingMatch = afterHeading.match(/(?:^|\n)#{1,6}\s+[^\n]+/);
    sectionContent = nextHeadingMatch
      ? afterHeading.slice(0, nextHeadingMatch.index).trim()
      : afterHeading;
  } else {
    introPart = cleanBody;
  }

  // Format intro: extract first paragraph or clean introductory paragraphs
  const plainIntro = introPart
    .replace(/\[([^\]]+)\]\([^)]+\)/g, '$1')
    .replace(/[*_`]/g, '')
    .trim();
  const introParas = plainIntro.split(/\n\s*\n/).map((p) => p.trim().replace(/\n/g, ' ')).filter(Boolean);
  let firstParagraph = '';
  if (introParas.length > 0) {
    if (introParas[0].length < 80 && introParas.length > 1) {
      firstParagraph = `${introParas[0]} ${introParas[1]}`;
    } else {
      firstParagraph = introParas[0];
    }
  }

  // Helper to format inline markdown links, bold, code
  const formatInline = (text: string) =>
    text
      .replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>')
      .replace(/\*([^*]+)\*/g, '<em>$1</em>')
      .replace(/`([^`]+)`/g, '<code class="px-1.5 py-0.5 rounded bg-slate-100 text-slate-700 text-xs font-mono">$1</code>')
      .replace(
        /\[([^\]]+)\]\(([^)]+)\)/g,
        '<a href="$2" target="_blank" rel="noopener noreferrer" class="text-brand-600 hover:text-brand-700 underline underline-offset-2 font-medium transition-colors">$1</a>'
      );

  // Check if sectionContent contains bullet list items
  const lines = sectionContent.split('\n').map((l) => l.trim()).filter(Boolean);
  const bulletLines = lines.filter((l) => /^[-*]\s+/.test(l));

  let headlineBullets: string[] = [];
  let headlineParagraph = '';

  if (bulletLines.length > 0 && bulletLines.length >= lines.length / 2) {
    headlineBullets = bulletLines.map((l) => formatInline(l.replace(/^[-*]\s+/, '').trim()));
  } else if (sectionContent) {
    const rawPara = sectionContent
      .split(/\n\s*\n/)[0]
      .replace(/\n/g, ' ')
      .trim();
    headlineParagraph = formatInline(rawPara);
  }

  return { firstParagraph, firstHeadline: headline, headlineBullets, headlineParagraph };
}

const { firstParagraph, firstHeadline, headlineBullets, headlineParagraph } = extractPostDetails(post.body);
const subtitle = post.data.description && post.data.description !== firstParagraph ? post.data.description : '';
const displayText = firstParagraph || post.data.description || 'LibreELEC updates, improvements, and system release information.';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const downloadsUrl = `${base}/downloads/`;
---

{featured ? (
    <article
        class="news-card glass-card rounded-3xl overflow-hidden border border-slate-200/90 hover:border-brand-400/80 shadow-md hover:shadow-xl transition-all duration-300 flex flex-col justify-between relative group md:col-span-2 lg:col-span-2 lg:row-span-3 bg-gradient-to-br from-white via-white to-brand-50/25 h-full"
        data-ncat={category}
        x-show={`filter === 'all' || filter === '${category}'`}
        x-transition
    >
        <!-- Ambient corner highlight -->
        <div class="absolute -right-12 -top-12 w-64 h-64 bg-brand-500/5 rounded-full blur-2xl pointer-events-none group-hover:bg-brand-500/10 transition-colors"></div>

        <div class="p-6 sm:p-8 lg:p-10 relative z-10 flex flex-col justify-between h-full">
            <div>
                <!-- Top metadata & badges bar -->
                <div class="flex flex-wrap items-center justify-between gap-3 mb-6">
                    <div class="flex items-center gap-2">
                        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-500 text-white font-extrabold text-[11px] uppercase tracking-wider shadow-sm">
                            <i class="fa-solid fa-star text-[10px]"></i> Latest Update
                        </span>
                        {category === 'release' ? (
                            <span class="px-2.5 py-1 rounded-full bg-brand-50 text-brand-700 font-bold text-xs border border-brand-200">
                                {categoryLabel}
                            </span>
                        ) : (
                            <span class="px-2.5 py-1 rounded-full bg-amber-50 text-amber-700 font-bold text-xs border border-amber-200">
                                {categoryLabel}
                            </span>
                        )}
                    </div>
                    <span class="font-mono text-xs text-slate-500 font-semibold bg-slate-100 px-2.5 py-1 rounded-md">
                        <i class="fa-regular fa-calendar mr-1 text-slate-400"></i> {formattedDate}
                    </span>
                </div>

                <!-- Featured Title -->
                <h3 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-slate-900 mb-3 hover:text-brand-600 transition-colors tracking-tight leading-tight">
                    <a href={url}>{post.data.title}</a>
                </h3>

                <!-- Subtitle / Tagline from post metadata if available -->
                {subtitle && (
                    <p class="text-xs font-bold text-brand-600 uppercase tracking-wider mb-3 font-mono">
                        {subtitle}
                    </p>
                )}

                <!-- First paragraph of full news text -->
                <p class="text-slate-600 text-sm sm:text-base leading-relaxed mb-5">
                    {displayText}
                </p>

                <!-- First Headline and Details -->
                {firstHeadline && (headlineBullets.length > 0 || headlineParagraph) && (
                    <div class="p-4 sm:p-5 rounded-2xl bg-slate-50/90 border border-slate-200/80 mb-6 shadow-sm">
                        <div class="flex items-center gap-2 mb-3">
                            <span class="w-2 h-2 rounded-full bg-brand-500"></span>
                            <h4 class="text-xs sm:text-sm font-bold uppercase tracking-wider text-slate-800">
                                {firstHeadline}
                            </h4>
                        </div>
                        {headlineBullets.length > 0 ? (
                            <ul class="space-y-2 text-xs sm:text-sm text-slate-600">
                                {headlineBullets.map((bullet) => (
                                    <li class="flex items-start gap-2.5">
                                        <i class="fa-solid fa-circle-check text-brand-500 text-[11px] mt-1 shrink-0"></i>
                                        <span set:html={bullet} class="leading-relaxed" />
                                    </li>
                                ))}
                            </ul>
                        ) : headlineParagraph ? (
                            <p class="text-slate-600 text-xs sm:text-sm leading-relaxed line-clamp-4" set:html={headlineParagraph} />
                        ) : null}
                    </div>
                )}
            </div>

            <!-- Featured Highlights Ribbon / Actions -->
            <div class="pt-6 border-t border-slate-100 flex flex-col sm:flex-row sm:items-center justify-between gap-4 mt-auto">
                <div class="flex items-center gap-2 text-xs text-slate-500">
                    <span class="w-8 h-8 rounded-full bg-brand-100 text-brand-700 flex items-center justify-center font-bold text-xs">
                        <i class="fa-solid fa-user"></i>
                    </span>
                    <div>
                        <span class="text-slate-400 text-[10px] block">Published by</span>
                        <span class="font-bold text-slate-800">{author}</span>
                    </div>
                </div>

                <div class="flex items-center gap-3">
                    <a
                        href={downloadsUrl}
                        class="px-4 py-2.5 rounded-xl bg-emerald-50 hover:bg-emerald-100 text-emerald-800 font-bold text-xs border border-emerald-200 transition-all flex items-center gap-1.5 shadow-sm"
                    >
                        <i class="fa-solid fa-download"></i> Downloads
                    </a>
                    <a
                        href={url}
                        class="px-5 py-2.5 rounded-xl bg-brand-600 hover:bg-brand-700 text-white font-bold text-xs sm:text-sm shadow-sm hover:shadow-md transition-all flex items-center gap-2"
                    >
                        Read Announcement <i class="fa-solid fa-arrow-right text-xs"></i>
                    </a>
                </div>
            </div>
        </div>
    </article>
) : (
    <article
        class="news-card glass-card rounded-2xl overflow-hidden border border-slate-200 flex flex-col justify-between h-full hover:border-brand-400 transition-all duration-200"
        data-ncat={category}
        x-show={`filter === 'all' || filter === '${category}'`}
        x-transition
    >
        <div class="p-5 sm:p-6">
            <div class="flex items-center justify-between text-xs text-slate-500 mb-2.5">
                {category === 'release' ? (
                    <span class="px-2 py-0.5 rounded-md bg-brand-50 text-brand-700 font-bold text-[11px] border border-brand-200">
                        {categoryLabel}
                    </span>
                ) : (
                    <span class="px-2 py-0.5 rounded-md bg-amber-50 text-amber-700 font-bold text-[11px] border border-amber-200">
                        {categoryLabel}
                    </span>
                )}
                <span class="font-medium font-mono text-[11px] text-slate-500">{formattedDate}</span>
            </div>
            <h3 class="text-base sm:text-lg font-bold text-slate-900 mb-2 hover:text-brand-600 transition-colors line-clamp-2 leading-snug">
                <a href={url}>{post.data.title}</a>
            </h3>
            <p class="text-slate-600 text-xs line-clamp-2 leading-relaxed">
                {displayText}
            </p>
        </div>
        <div class="px-5 sm:px-6 py-3 border-t border-slate-100 bg-slate-50/60 flex items-center justify-between text-xs mt-auto">
            <span class="text-slate-600 font-medium">
                <i class="fa-solid fa-user text-brand-600 mr-1 text-[11px]"></i> {author}
            </span>
            <a href={url} class="text-brand-600 font-bold hover:underline flex items-center gap-1">
                Read Post <i class="fa-solid fa-arrow-right text-[10px]"></i>
            </a>
        </div>
    </article>
)}

