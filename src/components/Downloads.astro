---
import { getFeaturedDownloads, getLatestVersion } from '../utils/downloads';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const downloadsUrl = `${base}/downloads/`;
const latestVersion = getLatestVersion();
const featured = getFeaturedDownloads();
---

<section id="downloads" class="py-24 bg-slate-100/60 relative border-t border-slate-200" x-data="{ category: 'all' }">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-3xl mx-auto mb-12">
            <span class="text-xs font-bold text-brand-600 uppercase tracking-widest mb-2 block">Featured Hardware</span>
            <h2 class="text-3xl sm:text-5xl font-extrabold text-slate-900 tracking-tight">
                Get LibreELEC {latestVersion.name}
            </h2>
            <p class="mt-4 text-slate-600 text-base">
                Download official disk images and update tarballs for popular platforms powered by Kodi {latestVersion.kodiVersion}.
            </p>
        </div>

        <!-- Platform Category Tabs (Alpine.js) -->
        <div class="flex flex-wrap items-center justify-center gap-2 sm:gap-3 mb-12">
            <button
                type="button"
                @click="category = 'all'"
                class="dl-tab px-5 py-2.5 rounded-xl font-semibold text-sm transition-all"
                :class="category === 'all' ? 'bg-brand-600 text-white shadow-md shadow-brand-500/20' : 'text-slate-600 hover:text-slate-900 bg-white border border-slate-200 hover:border-slate-300 shadow-sm'"
            >
                All Featured
            </button>
            <button
                type="button"
                @click="category = 'raspberry'"
                class="dl-tab px-5 py-2.5 rounded-xl font-semibold text-sm transition-all"
                :class="category === 'raspberry' ? 'bg-brand-600 text-white shadow-md shadow-brand-500/20' : 'text-slate-600 hover:text-slate-900 bg-white border border-slate-200 hover:border-slate-300 shadow-sm'"
            >
                <i class="fa-brands fa-raspberry-pi mr-1.5 text-red-600"></i> Raspberry Pi
            </button>
            <button
                type="button"
                @click="category = 'generic'"
                class="dl-tab px-5 py-2.5 rounded-xl font-semibold text-sm transition-all"
                :class="category === 'generic' ? 'bg-brand-600 text-white shadow-md shadow-brand-500/20' : 'text-slate-600 hover:text-slate-900 bg-white border border-slate-200 hover:border-slate-300 shadow-sm'"
            >
                <i class="fa-solid fa-desktop mr-1.5 text-blue-600"></i> Generic PC (x86_64)
            </button>
            <button
                type="button"
                @click="category = 'arm'"
                class="dl-tab px-5 py-2.5 rounded-xl font-semibold text-sm transition-all"
                :class="category === 'arm' ? 'bg-brand-600 text-white shadow-md shadow-brand-500/20' : 'text-slate-600 hover:text-slate-900 bg-white border border-slate-200 hover:border-slate-300 shadow-sm'"
            >
                <i class="fa-solid fa-microchip mr-1.5 text-emerald-600"></i> Rockchip / Amlogic
            </button>
        </div>

        <!-- Download Cards Grid (Dynamic from config.yml) -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-12">
            {featured.map((item) => (
                <div
                    x-show={`category === 'all' || category === '${item.platformId}' || (category === 'arm' && ('${item.platformId}' === 'rockchip' || '${item.platformId}' === 'amlogic' || '${item.platformId}' === 'allwinner'))`}
                    x-transition
                    class="dl-card glass-card rounded-2xl p-6 border border-slate-200 flex flex-col justify-between bg-white hover:border-brand-300 hover:shadow-md transition-all duration-200"
                >
                    <div>
                        <div class="flex items-center justify-between mb-4">
                            <span class={`px-3 py-1 rounded-full text-xs font-bold border flex items-center gap-1.5 ${
                                item.badgeColor === 'red' ? 'bg-red-50 text-red-600 border-red-200' :
                                item.badgeColor === 'blue' ? 'bg-blue-50 text-blue-600 border-blue-200' :
                                item.badgeColor === 'emerald' ? 'bg-emerald-50 text-emerald-600 border-emerald-200' :
                                item.badgeColor === 'purple' ? 'bg-purple-50 text-purple-600 border-purple-200' :
                                'bg-slate-50 text-slate-700 border-slate-200'
                            }`}>
                                <i class={item.icon}></i> {item.platformName}
                            </span>
                            <span class="text-xs text-slate-500 font-mono font-semibold">v{item.downloadVersion}</span>
                        </div>
                        <h3 class="text-xl font-bold text-slate-900 mb-1">{item.deviceName}</h3>
                        {item.chipset && (
                            <p class="text-[11px] text-slate-500 font-mono mb-2">{item.chipset}</p>
                        )}
                        <p class="text-slate-600 text-xs mb-4 leading-relaxed">
                            {item.features || 'Tailored LibreELEC disk image.'}
                        </p>
                    </div>

                    <div class="space-y-3 pt-4 border-t border-slate-100">
                        <button
                            type="button"
                            @click={`$store.ui.openDownloadModal('${item.deviceName}', '${item.imageFileName}', '${item.imageUrl}', '${item.mirrorListUrl}')`}
                            class="w-full py-3 rounded-xl bg-brand-600 hover:bg-brand-700 text-white font-bold text-xs flex items-center justify-center gap-2 transition-all shadow-sm"
                        >
                            <i class="fa-solid fa-download"></i> Direct Image Download (.img.gz)
                        </button>
                        <div class="flex items-center justify-between text-[11px] font-mono text-slate-500">
                            <a
                                href={item.updateUrl}
                                class="hover:text-brand-600 font-medium"
                                title="Download manual update tarball"
                            >
                                <i class="fa-solid fa-file-zipper"></i> Update (.tar)
                            </a>
                            <a
                                href={item.mirrorListUrl}
                                target="_blank"
                                rel="noopener"
                                class="hover:text-brand-600 font-semibold"
                            >
                                <i class="fa-solid fa-shield-halved"></i> SHA256 Checksum
                            </a>
                        </div>
                    </div>
                </div>
            ))}
        </div>

        <!-- Call to Action Banner pointing to the Unified Download Hub -->
        <div class="glass-card rounded-2xl p-8 border border-brand-200 bg-gradient-to-r from-brand-50/50 via-white to-brand-50/30 shadow-sm text-center max-w-4xl mx-auto">
            <h3 class="text-xl font-extrabold text-slate-900 mb-2">
                Looking for another device or an older LibreELEC version?
            </h3>
            <p class="text-slate-600 text-sm mb-6 max-w-2xl mx-auto">
                Our complete Download Center includes over 50+ supported devices across Raspberry Pi, Generic x86, Rockchip, Amlogic, Allwinner, and older LibreELEC versions (12.0, 11.0, 10.0, 9.2).
            </p>
            <a
                href={downloadsUrl}
                class="inline-flex items-center gap-2 px-8 py-3.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-white font-bold text-sm shadow-md hover:shadow-lg transition-all"
            >
                <span>Browse Full Download Hub (All Versions & Devices)</span>
                <i class="fa-solid fa-arrow-right text-xs"></i>
            </a>
        </div>
    </div>
</section>
