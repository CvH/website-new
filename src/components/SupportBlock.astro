---
interface Props {
  class?: string;
  title?: string;
  description?: string;
  donateUrl?: string;
  buttonText?: string;
}

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const defaultSponsorUrl = `${base}/sponsor/`;

const {
  class: className = '',
  title = 'Support LibreELEC Development',
  description = 'We are 100% community supported. Your contribution helps fund build infrastructure and test devices.',
  donateUrl = defaultSponsorUrl,
  buttonText = 'Sponsor LibreELEC',
} = Astro.props;

const isExternal = donateUrl.startsWith('http');
---

<div class:list={["my-8 p-6 rounded-2xl glass-card border border-brand-200/80 dark:border-brand-800/60 bg-gradient-to-r from-brand-50/60 to-sky-50/40 dark:from-brand-950/40 dark:to-slate-900/60 shadow-sm flex flex-col sm:flex-row items-center justify-between gap-5 not-prose", className]}>
  <div class="flex items-center gap-4">
    <div class="w-12 h-12 rounded-xl bg-brand-500/10 dark:bg-brand-900/30 border border-brand-500/20 dark:border-brand-700/40 text-brand-600 dark:text-brand-400 flex items-center justify-center text-xl shrink-0">
      <i class="fa-solid fa-heart text-rose-500"></i>
    </div>
    <div>
      <h4 class="font-bold text-slate-900 dark:text-white text-base m-0">{title}</h4>
      <p class="text-xs text-slate-600 dark:text-slate-300 mt-1 mb-0">{description}</p>
    </div>
  </div>
  <a
    href={donateUrl}
    target={isExternal ? '_blank' : undefined}
    rel={isExternal ? 'noopener' : undefined}
    class="shrink-0 px-5 py-2.5 rounded-xl bg-brand-600 hover:bg-brand-700 text-white font-bold text-xs shadow-md shadow-brand-500/20 hover:shadow-brand-500/35 hover:-translate-y-0.5 transition-all duration-200 flex items-center gap-2 no-underline"
  >
    <i class="fa-solid fa-heart text-rose-300"></i> {buttonText}
  </a>
</div>
