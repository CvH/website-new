---
---
<section class="py-10 border-y border-slate-200 bg-white shadow-sm">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
            <div class="p-4">
                <div class="text-3xl sm:text-4xl font-extrabold text-slate-900 font-mono mb-1"><span class="text-brand-600">&lt;</span> 150 MB</div>
                <div class="text-xs uppercase tracking-wider text-slate-500 font-bold">Tiny Storage Footprint</div>
            </div>
            <div class="p-4">
                <div class="text-3xl sm:text-4xl font-extrabold text-slate-900 font-mono mb-1">~5 Sec</div>
                <div class="text-xs uppercase tracking-wider text-slate-500 font-bold">Ultra Fast Boot Time</div>
            </div>
            <div class="p-4">
                <div class="text-3xl sm:text-4xl font-extrabold text-slate-900 font-mono mb-1">100%</div>
                <div class="text-xs uppercase tracking-wider text-slate-500 font-bold">Open Source & Free</div>
            </div>
            <div class="p-4">
                <div class="text-3xl sm:text-4xl font-extrabold text-slate-900 font-mono mb-1">10M+</div>
                <div class="text-xs uppercase tracking-wider text-slate-500 font-bold">Active Installations</div>
            </div>
        </div>
    </div>
</section>

<section id="features" class="py-24 relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-3xl mx-auto mb-16">
            <h2 class="text-xs font-bold text-brand-600 uppercase tracking-widest mb-3">Why LibreELEC?</h2>
            <p class="text-3xl sm:text-5xl font-extrabold text-slate-900 tracking-tight">Designed for zero distraction.</p>
            <p class="mt-4 text-slate-600 text-base sm:text-lg">
                Traditional Linux distributions carry gigabytes of unused packages. LibreELEC is stripped down to the bare essentials required to run Kodi flawlessly.
            </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            <!-- Feature Card 1 -->
            <div class="glass-card p-8 rounded-2xl relative overflow-hidden group">
                <div class="w-12 h-12 rounded-xl bg-brand-50 border border-brand-100 text-brand-600 flex items-center justify-center text-xl mb-6 group-hover:bg-brand-600 group-hover:text-white transition-all duration-300">
                    <i class="fa-solid fa-feather-pointed"></i>
                </div>
                <h3 class="text-xl font-bold text-slate-900 mb-3">Just Enough OS</h3>
                <p class="text-slate-600 text-sm leading-relaxed">
                    No window managers, no background desktop bloat, no unused drivers. Read-only system partition ensures stability and protects against corruption.
                </p>
            </div>

            <!-- Feature Card 2 -->
            <div class="glass-card p-8 rounded-2xl relative overflow-hidden group">
                <div class="w-12 h-12 rounded-xl bg-brand-50 border border-brand-100 text-brand-600 flex items-center justify-center text-xl mb-6 group-hover:bg-brand-600 group-hover:text-white transition-all duration-300">
                    <i class="fa-solid fa-arrows-rotate"></i>
                </div>
                <h3 class="text-xl font-bold text-slate-900 mb-3">Seamless Updates</h3>
                <p class="text-slate-600 text-sm leading-relaxed">
                    Automatic background updates keep your system safe and aligned with the newest Kodi releases. Upgrade with a single click or automatic schedules.
                </p>
            </div>

            <!-- Feature Card 3 -->
            <div class="glass-card p-8 rounded-2xl relative overflow-hidden group">
                <div class="w-12 h-12 rounded-xl bg-brand-50 border border-brand-100 text-brand-600 flex items-center justify-center text-xl mb-6 group-hover:bg-brand-600 group-hover:text-white transition-all duration-300">
                    <i class="fa-solid fa-sliders"></i>
                </div>
                <h3 class="text-xl font-bold text-slate-900 mb-3">Hardware Accelerated</h3>
                <p class="text-slate-600 text-sm leading-relaxed">
                    Deep integration with V4L2/GBM pipelines, full 4K HDR10, AV1 decoding, and HD audio passthrough (Dolby Atmos, DTS:X) straight out of the box.
                </p>
            </div>

            <!-- Feature Card 4 -->
            <div class="glass-card p-8 rounded-2xl relative overflow-hidden group">
                <div class="w-12 h-12 rounded-xl bg-brand-50 border border-brand-100 text-brand-600 flex items-center justify-center text-xl mb-6 group-hover:bg-brand-600 group-hover:text-white transition-all duration-300">
                    <i class="fa-solid fa-plug"></i>
                </div>
                <h3 class="text-xl font-bold text-slate-900 mb-3">HDMI-CEC Out-of-the-Box</h3>
                <p class="text-slate-600 text-sm leading-relaxed">
                    Control your entire Kodi interface using your existing TV remote control via HDMI-CEC automatically without setting up infra-red dongles.
                </p>
            </div>

            <!-- Feature Card 5 -->
            <div class="glass-card p-8 rounded-2xl relative overflow-hidden group">
                <div class="w-12 h-12 rounded-xl bg-brand-50 border border-brand-100 text-brand-600 flex items-center justify-center text-xl mb-6 group-hover:bg-brand-600 group-hover:text-white transition-all duration-300">
                    <i class="fa-solid fa-gears"></i>
                </div>
                <h3 class="text-xl font-bold text-slate-900 mb-3">LibreELEC Settings Add-on</h3>
                <p class="text-slate-600 text-sm leading-relaxed">
                    Configure Wi-Fi networks, Bluetooth remotes, static IP address, SSH access, and system updates directly within the TV UI without a terminal.
                </p>
            </div>

            <!-- Feature Card 6 -->
            <div class="glass-card p-8 rounded-2xl relative overflow-hidden group">
                <div class="w-12 h-12 rounded-xl bg-brand-50 border border-brand-100 text-brand-600 flex items-center justify-center text-xl mb-6 group-hover:bg-brand-600 group-hover:text-white transition-all duration-300">
                    <i class="fa-solid fa-shield-halved"></i>
                </div>
                <h3 class="text-xl font-bold text-slate-900 mb-3">Rock Solid Stability</h3>
                <p class="text-slate-600 text-sm leading-relaxed">
                    Read-only squashfs system structure ensures your TV setup never fails due to unclean power cutoffs or abrupt shutdowns.
                </p>
            </div>
        </div>
    </div>
</section>
