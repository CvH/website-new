---
import LibreElecLogo from './LibreElecLogo.astro';
import SunMoonIcon from './SunMoonIcon.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const homeUrl = base ? `${base}/` : '/';
const downloadsUrl = `${base}/downloads/`;
const donateUrl = "https://opencollective.com/libreelec/donate";
---

<nav class="fixed top-0 left-0 right-0 z-50 glass-panel border-b border-slate-200/80 dark:border-slate-800 transition-all duration-300" id="navbar" x-data="{ mobileOpen: false }">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-20">
            <!-- Logo -->
            <a href={homeUrl} class="flex items-center gap-3 group">
                <div class="w-10 h-10 flex items-center justify-center group-hover:scale-105 transition-transform duration-300">
                    <LibreElecLogo class="w-10 h-10" dropShadow={true} />
                </div>
                <div class="flex flex-col">
                    <span class="text-xl font-extrabold tracking-tight text-slate-900 dark:text-white">
                        LibreELEC
                    </span>
                    <span class="text-[10px] tracking-wide text-slate-500 dark:text-slate-400 font-semibold">Just enough OS for KODI</span>
                </div>
            </a>

            <!-- Desktop Nav Links -->
            <div class="hidden lg:flex items-center gap-6 xl:gap-8">
                <a href={`${homeUrl}#news`} class="text-sm font-semibold text-slate-600 dark:text-slate-300 hover:text-brand-600 dark:hover:text-brand-400 transition-colors">News</a>
                <a href={downloadsUrl} class="text-sm font-semibold text-slate-600 dark:text-slate-300 hover:text-brand-600 dark:hover:text-brand-400 transition-colors">Downloads</a>
                <a href={`${homeUrl}#features`} class="text-sm font-semibold text-slate-600 dark:text-slate-300 hover:text-brand-600 dark:hover:text-brand-400 transition-colors">Features</a>
                <a href={`${homeUrl}#creator`} class="text-sm font-semibold text-slate-600 dark:text-slate-300 hover:text-brand-600 dark:hover:text-brand-400 transition-colors">USB Tool</a>
                <a href="https://wiki.libreelec.tv" target="_blank" rel="noopener" class="text-sm font-semibold text-slate-600 dark:text-slate-300 hover:text-brand-600 dark:hover:text-brand-400 transition-colors">Docs</a>
            </div>

            <!-- CTA & Actions -->
            <div class="hidden lg:flex items-center gap-3">
                <a href="https://forum.libreelec.tv" target="_blank" rel="noopener" class="text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white px-3 py-2 text-sm font-semibold transition-colors flex items-center gap-1.5">
                    <i class="fa-solid fa-comments text-brand-600"></i> Forum
                </a>
                <a href={donateUrl} target="_blank" rel="noopener" class="px-3.5 py-2 rounded-xl bg-rose-50 hover:bg-rose-100/90 text-rose-600 hover:text-rose-700 border border-rose-200/80 dark:bg-rose-950/40 dark:border-rose-900/60 dark:text-rose-300 dark:hover:bg-rose-900/40 font-bold text-sm shadow-sm hover:shadow hover:-translate-y-0.5 transition-all duration-200 flex items-center gap-2 group">
                    <i class="fa-solid fa-heart text-rose-500 group-hover:scale-110 transition-transform"></i>
                    <span>Donate</span>
                </a>
                <a href={downloadsUrl} class="px-5 py-2.5 rounded-xl bg-brand-600 hover:bg-brand-700 text-white font-bold text-sm shadow-md shadow-brand-500/20 hover:shadow-brand-500/35 hover:-translate-y-0.5 transition-all duration-200">
                    Get LibreELEC
                </a>

                <!-- Top-Right 3-State Theme Switcher -->
                <button
                    @click="$store.theme.cycle()"
                    type="button"
                    class="relative p-2.5 rounded-xl border border-slate-200/90 dark:border-slate-700/80 bg-white/80 dark:bg-slate-800/80 hover:bg-slate-100 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 transition-all duration-200 shadow-sm hover:scale-105 active:scale-95 flex items-center justify-center w-10 h-10 group"
                    :title="$store.theme.getTooltip()"
                    :aria-label="$store.theme.getTooltip()"
                    id="theme-toggle-desktop"
                >
                    <i x-show="$store.theme.current === 'light'" class="fa-solid fa-sun text-amber-500 text-base group-hover:rotate-45 transition-transform" x-cloak></i>
                    <i x-show="$store.theme.current === 'dark'" class="fa-solid fa-moon text-sky-400 text-base group-hover:-rotate-12 transition-transform" x-cloak></i>
                    <span x-show="$store.theme.current === 'system'" class="flex items-center justify-center group-hover:scale-110 transition-transform" x-cloak>
                        <SunMoonIcon class="w-[18px] h-[18px]" size={18} />
                    </span>
                </button>
            </div>

            <!-- Mobile menu button & quick actions -->
            <div class="lg:hidden flex items-center gap-2">
                <!-- Mobile Top-Right Theme Toggle -->
                <button
                    @click="$store.theme.cycle()"
                    type="button"
                    class="p-2 rounded-xl border border-slate-200/80 dark:border-slate-700 bg-white/80 dark:bg-slate-800 text-slate-700 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-700 transition-colors w-9 h-9 flex items-center justify-center shadow-sm"
                    :title="$store.theme.getTooltip()"
                    :aria-label="$store.theme.getTooltip()"
                    id="theme-toggle-mobile"
                >
                    <i x-show="$store.theme.current === 'light'" class="fa-solid fa-sun text-amber-500 text-sm" x-cloak></i>
                    <i x-show="$store.theme.current === 'dark'" class="fa-solid fa-moon text-sky-400 text-sm" x-cloak></i>
                    <span x-show="$store.theme.current === 'system'" class="flex items-center justify-center" x-cloak>
                        <SunMoonIcon class="w-4 h-4" size={16} />
                    </span>
                </button>

                <a href={donateUrl} target="_blank" rel="noopener" class="px-3 py-1.5 rounded-xl bg-rose-50 dark:bg-rose-950/40 text-rose-600 dark:text-rose-300 border border-rose-200/80 dark:border-rose-900/60 text-xs font-bold flex items-center gap-1.5 shadow-sm">
                    <i class="fa-solid fa-heart text-rose-500"></i>
                    <span>Donate</span>
                </a>
                <button @click="mobileOpen = !mobileOpen" type="button" class="text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white focus:outline-none p-2 rounded-lg" aria-label="Toggle navigation">
                    <i class="fa-solid" :class="mobileOpen ? 'fa-xmark text-xl' : 'fa-bars text-xl'"></i>
                </button>
            </div>
        </div>
    </div>

    <!-- Mobile Nav Menu (Alpine.js) -->
    <div x-show="mobileOpen" x-transition.opacity.duration.200ms class="lg:hidden border-t border-slate-200 dark:border-slate-800 bg-white/95 dark:bg-slate-900/95 backdrop-blur-xl px-4 pt-3 pb-6 space-y-3" style="display: none;">
        <a @click="mobileOpen = false" href={`${homeUrl}#news`} class="block px-3 py-2 rounded-lg text-base font-medium text-slate-700 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800">News</a>
        <a @click="mobileOpen = false" href={downloadsUrl} class="block px-3 py-2 rounded-lg text-base font-medium text-slate-700 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800">Downloads</a>
        <a @click="mobileOpen = false" href={`${homeUrl}#features`} class="block px-3 py-2 rounded-lg text-base font-medium text-slate-700 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800">Features</a>
        <a @click="mobileOpen = false" href={`${homeUrl}#creator`} class="block px-3 py-2 rounded-lg text-base font-medium text-slate-700 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800">USB Tool</a>
        <a href="https://wiki.libreelec.tv" target="_blank" rel="noopener" class="block px-3 py-2 rounded-lg text-base font-medium text-slate-700 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800">Docs</a>
        <a href="https://forum.libreelec.tv" target="_blank" rel="noopener" class="block px-3 py-2 rounded-lg text-base font-medium text-slate-700 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800">Community Forum</a>
        <a href={donateUrl} target="_blank" rel="noopener" class="flex items-center gap-2 px-3 py-2 rounded-lg text-base font-medium text-rose-600 dark:text-rose-400 hover:bg-rose-50 dark:hover:bg-rose-950/40">
            <i class="fa-solid fa-heart text-rose-500"></i> Donate on OpenCollective
        </a>

        <!-- Appearance Selector in Mobile Drawer -->
        <div class="pt-3 border-t border-slate-200 dark:border-slate-800 flex items-center justify-between px-1">
            <span class="text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Theme</span>
            <div class="flex items-center gap-1 bg-slate-100 dark:bg-slate-800 p-1 rounded-xl border border-slate-200 dark:border-slate-700">
                <button
                    type="button"
                    @click="$store.theme.setTheme('light')"
                    class="px-2.5 py-1 rounded-lg text-xs font-semibold flex items-center gap-1.5 transition-all"
                    :class="$store.theme.current === 'light' ? 'bg-white dark:bg-slate-700 text-slate-900 dark:text-white shadow-sm font-bold' : 'text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white'"
                >
                    <i class="fa-solid fa-sun text-amber-500 text-xs"></i> Light
                </button>
                <button
                    type="button"
                    @click="$store.theme.setTheme('dark')"
                    class="px-2.5 py-1 rounded-lg text-xs font-semibold flex items-center gap-1.5 transition-all"
                    :class="$store.theme.current === 'dark' ? 'bg-white dark:bg-slate-700 text-slate-900 dark:text-white shadow-sm font-bold' : 'text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white'"
                >
                    <i class="fa-solid fa-moon text-sky-400 text-xs"></i> Dark
                </button>
                <button
                    type="button"
                    @click="$store.theme.setTheme('system')"
                    class="px-2.5 py-1 rounded-lg text-xs font-semibold flex items-center gap-1.5 transition-all"
                    :class="$store.theme.current === 'system' ? 'bg-white dark:bg-slate-700 text-slate-900 dark:text-white shadow-sm font-bold' : 'text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white'"
                >
                    <SunMoonIcon class="w-3.5 h-3.5" size={14} /> Auto
                </button>
            </div>
        </div>

        <div class="pt-2">
            <a @click="mobileOpen = false" href={downloadsUrl} class="block w-full text-center px-5 py-3 rounded-xl bg-brand-600 text-white font-bold text-sm shadow-md">
                Get LibreELEC Now
            </a>
        </div>
    </div>
</nav>
